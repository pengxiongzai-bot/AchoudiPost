---
import type { GetStaticPaths } from "astro";
import PortalShell from "../../layouts/PortalShell.astro";
import { skillModules } from "../../data/skill-modules";
import type { SkillModule } from "../../data/skill-modules";

export const getStaticPaths = (() =>
  skillModules.map((module) => ({
    params: { slug: module.slug },
    props: { module }
  }))) satisfies GetStaticPaths;

const { module } = Astro.props as { module: SkillModule };
const visibleResourceCards = module.slug === "visual" ? module.resourceCards.slice(0, 1) : module.resourceCards;
const primaryResourceCard = module.resourceCards[0];
const skillDialogImages = module.resourceCards.flatMap((card) =>
  card.image
    ? [{
        src: card.image,
        label: card.title
      }]
    : []
);
const skillDialogImagePairs = skillDialogImages.reduce<(typeof skillDialogImages)[]>((pairs, image, index) => {
  if (index % 2 === 0) pairs.push([image]);
  else pairs[pairs.length - 1].push(image);
  return pairs;
}, []);
const skillDialog =
  module.slug === "visual" && primaryResourceCard
    ? {
        title: `${primaryResourceCard.title} Skill`,
        summary: "把产品、卖点和目标人群整理成一张更容易停留、理解和点击的主图方案。",
        activeVersionIndex: 0,
        versions: [
          {
            id: "standard",
            title: "标准版",
            details: [
              ["适合", "新品上架、主图缺少基础结构，或需要先把卖点排清楚的场景"],
              ["输入", "商品图、核心卖点、目标人群和平台尺寸"],
              ["主要能力", "卖点提炼 / 主视觉构图 / 标题层级 / 基础检查"],
              ["输出", "一张可用于测试方向的主图结构方案"]
            ]
          },
          {
            id: "enhanced",
            title: "增强版",
            details: [
              ["适合", "已有主图但点击率不稳定，需要强化利益点和画面记忆点的场景"],
              ["输入", "商品图、竞品参考、核心卖点、目标人群和风格方向"],
              ["主要能力", "利益点强化 / 场景氛围 / 文案排布 / 对比优化"],
              ["输出", "一套更适合投放、搜索和活动页使用的主图方案"]
            ]
          },
          {
            id: "stable",
            title: "稳定版",
            details: [
              ["适合", "新品上架、主图点击率低、卖点分散，或需要统一主图表达的场景"],
              ["输入", "商品图、核心卖点、目标人群、平台尺寸和参考风格"],
              ["主要能力", "利益点提炼 / 构图层级 / 文案排布 / 视觉一致性检查"],
              ["输出", "可继续用于主图、广告图和改投素材的一套视觉方案"]
            ]
          }
        ],
        images: skillDialogImages,
        imagePairs: skillDialogImagePairs
      }
    : null;
---

<PortalShell
  activePage="market"
  title={module.name}
  description={module.summary}
  hideFooter={true}
  bodyClass="skill-detail-page"
>
  <section class="skill-detail" aria-labelledby="skillDetailTitle">
    <div class="skill-detail-inner">
      <section class="skill-library-intro" data-skill-detail-hero>
        <div class="skill-library-copy">
          <h1 id="skillDetailTitle">{module.headline}</h1>
          <p class="skill-summary">{module.summary}</p>
        </div>
      </section>

      <section class="skill-library-toolbar" aria-label="框架筛选">
        <div class="skill-tabs" aria-label="当前分类">
          <strong>全部</strong>
          <span>{module.job}</span>
          <span>基础框架</span>
          <span>私域落地</span>
        </div>
      </section>

      <section id="skillFrameworks" class="skill-resource-grid" aria-label={`${module.name} 框架列表`}>
        {visibleResourceCards.map((card, index) => (
          <article
            class="skill-resource-card"
            role={skillDialog ? "button" : undefined}
            tabindex={skillDialog ? 0 : undefined}
            data-skill-detail-open={skillDialog ? "" : undefined}
            aria-controls={skillDialog ? "skillDetailDialog" : undefined}
            aria-haspopup={skillDialog ? "dialog" : undefined}
            aria-label={skillDialog ? `打开 ${card.title} Skill 详情` : undefined}
          >
            <figure class="skill-resource-cover">
              <img
                src={card.image ?? module.image}
                alt={`${card.title}参考画面`}
                loading={index > 2 ? "lazy" : "eager"}
              />
              <div class="skill-resource-shade"></div>
            </figure>
            <div class="skill-resource-content">
              <h2>{card.title}</h2>
              <p>{card.description}</p>
            </div>
          </article>
        ))}
      </section>

      <section class="skill-bottom-cta" aria-label="咨询联系">
        <h2>把你的产品、类目和当前卡点发我</h2>
        <span>我会先判断从哪个框架切入，再把它细化成你可以直接用的执行路径。</span>
        <a class="skill-button primary" href="/#sf-counter" data-portal-route>去微信联系</a>
      </section>

      {skillDialog && (
        <dialog id="skillDetailDialog" class="skill-popup-dialog" data-skill-detail-dialog aria-labelledby="skillDialogTitle">
          <button class="skill-popup-close" type="button" data-skill-detail-close aria-label="关闭 Skill 详情">
            <i data-lucide="x"></i>
          </button>

          <div class="skill-popup-layout">
            <section class="skill-popup-media" aria-label="Skill 案例预览">
              <div class="skill-popup-stage">
                <figure>
                  <span>整理前</span>
                  <button
                    class="skill-popup-preview-trigger"
                    type="button"
                    data-skill-image-preview-trigger
                    data-skill-preview-src={skillDialog.images[0]?.src ?? module.image}
                    data-skill-preview-srcs={JSON.stringify([skillDialog.images[0]?.src ?? module.image, skillDialog.images[0]?.src ?? module.image])}
                    aria-label={`放大预览 ${skillDialog.title}整理前示例`}
                  >
                    <img src={skillDialog.images[0]?.src ?? module.image} alt={`${skillDialog.title}整理前示例`} loading="eager" />
                  </button>
                </figure>
                <figure>
                  <span>整理后</span>
                  <button
                    class="skill-popup-preview-trigger"
                    type="button"
                    data-skill-image-preview-trigger
                    data-skill-preview-src={skillDialog.images[0]?.src ?? module.image}
                    data-skill-preview-srcs={JSON.stringify([skillDialog.images[0]?.src ?? module.image, skillDialog.images[0]?.src ?? module.image])}
                    aria-label={`放大预览 ${skillDialog.title}整理后示例`}
                  >
                    <img src={skillDialog.images[0]?.src ?? module.image} alt={`${skillDialog.title}整理后示例`} loading="eager" />
                  </button>
                </figure>
                <span class="skill-popup-arrow" aria-hidden="true">→</span>
              </div>

              <div class="skill-popup-strip" aria-label="更多案例">
                {skillDialog.imagePairs.slice(0, 3).map((pair, index) => (
                  <button
                    class="skill-popup-pair-trigger"
                    type="button"
                    data-skill-image-preview-trigger
                    data-skill-preview-src={pair[0]?.src}
                    data-skill-preview-srcs={JSON.stringify(pair.map((image) => image.src))}
                    aria-label={`放大预览第 ${index + 1} 组案例`}
                  >
                    {pair.map((image) => (
                      <span class="skill-popup-pair-image">
                        <img src={image.src} alt={image.label} loading="lazy" />
                      </span>
                    ))}
                  </button>
                ))}
              </div>
            </section>

            <section class="skill-popup-info" aria-labelledby="skillDialogTitle">
              <h2 id="skillDialogTitle">{skillDialog.title}</h2>
              <p>{skillDialog.summary}</p>

              <div class="skill-popup-version" aria-label="版本选择">
                <span>版本选择</span>
                <div role="tablist" aria-label="Skill 版本">
                  {skillDialog.versions.map((version, index) => (
                    <button
                      id={`skillVersionTab-${version.id}`}
                      class:list={[{ active: index === skillDialog.activeVersionIndex }]}
                      type="button"
                      role="tab"
                      aria-selected={index === skillDialog.activeVersionIndex ? "true" : "false"}
                      aria-controls={`skillVersionPanel-${version.id}`}
                      data-skill-version-button={version.id}
                    >
                      {version.title}
                    </button>
                  ))}
                </div>
              </div>

              {skillDialog.versions.map((version, index) => (
                <dl
                  id={`skillVersionPanel-${version.id}`}
                  class="skill-popup-details"
                  role="tabpanel"
                  aria-labelledby={`skillVersionTab-${version.id}`}
                  data-skill-version-panel={version.id}
                  hidden={index !== skillDialog.activeVersionIndex}
                >
                  {version.details.map(([label, value]) => (
                    <div>
                      <dt>{label}</dt>
                      <dd>{value}</dd>
                    </div>
                  ))}
                </dl>
              ))}

              <a class="skill-popup-cta" href="/#sf-counter" data-portal-route>获取这个版本</a>
            </section>
          </div>

          <div class="skill-image-preview" data-skill-image-preview hidden role="dialog" aria-modal="true" aria-label="图片放大预览">
            <button class="skill-image-preview-backdrop" type="button" data-skill-image-preview-close aria-label="关闭图片预览"></button>
            <figure class="skill-image-preview-panel">
              <button class="skill-popup-close skill-image-preview-close" type="button" data-skill-image-preview-close aria-label="关闭图片预览">
                <i data-lucide="x"></i>
              </button>
              <div class="skill-image-preview-grid" data-skill-image-preview-grid></div>
            </figure>
          </div>
        </dialog>
      )}
    </div>
  </section>
</PortalShell>

<style>
  .skill-detail {
    min-height: 100svh;
    color: #f4f2eb;
    background:
      radial-gradient(circle at 50% 0%, rgba(255, 255, 255, 0.06), transparent 34rem),
      linear-gradient(180deg, #050604 0%, #090a07 42%, #10120d 100%);
    padding: clamp(2.2rem, 5vw, 4.5rem) clamp(1rem, 4vw, 4rem) clamp(4rem, 7vw, 7rem);
  }

  .skill-detail-inner {
    width: min(1280px, 100%);
    margin: 0 auto;
  }

  .skill-library-intro {
    display: block;
    padding: clamp(4rem, 8vw, 7rem) 0 clamp(2.5rem, 4vw, 3.8rem);
  }

  .skill-library-copy {
    max-width: 760px;
  }

  .skill-library-copy h1 {
    max-width: 860px;
    margin: 0;
    font-family: "Noto Serif SC", "Songti SC", "STSong", "SimSun", ui-serif, Georgia, serif;
    font-size: clamp(2.6rem, 5.5vw, 5.9rem);
    font-weight: 400;
    line-height: 1.04;
    letter-spacing: -0.075em;
    white-space: pre-line;
  }

  .skill-summary {
    max-width: 620px;
    margin: 1.65rem 0 0;
    color: rgba(244, 242, 235, 0.62);
    font-size: clamp(1rem, 1.35vw, 1.18rem);
    line-height: 1.9;
    white-space: pre-line;
  }

  .skill-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 3rem;
    border-radius: 999px;
    padding: 0 1.25rem;
    font-size: 0.92rem;
    font-weight: 800;
    text-decoration: none;
    transition: transform 0.18s ease, border-color 0.18s ease, background 0.18s ease;
  }

  .skill-button:hover {
    transform: translateY(-1px);
  }

  .skill-button.primary {
    color: #0a0b08;
    background: #f7f5ee;
  }

  .skill-library-toolbar {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: 1rem;
    margin-bottom: clamp(1.2rem, 2.8vw, 2rem);
    border-top: 1px solid rgba(244, 242, 235, 0.11);
    border-bottom: 1px solid rgba(244, 242, 235, 0.11);
    min-height: 4.2rem;
  }

  .skill-tabs {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    flex-wrap: wrap;
  }

  .skill-tabs span,
  .skill-tabs strong {
    min-height: 2.35rem;
    display: inline-flex;
    align-items: center;
    border-radius: 999px;
    padding: 0 0.95rem;
    color: rgba(244, 242, 235, 0.58);
    border: 1px solid rgba(244, 242, 235, 0.18);
    background: rgba(255, 255, 255, 0.035);
    font-size: 0.82rem;
    font-weight: 800;
    text-decoration: none;
  }

  .skill-tabs strong {
    color: #090a07;
    background: #f7f5ee;
    border-color: #f7f5ee;
  }

  .skill-resource-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1rem, 2vw, 1.35rem);
  }

  .skill-resource-card {
    overflow: hidden;
    border: 1px solid rgba(244, 242, 235, 0.12);
    background: rgba(255, 255, 255, 0.035);
    box-shadow: 0 1rem 3rem rgba(0, 0, 0, 0.2);
  }

  .skill-resource-card[data-skill-detail-open] {
    cursor: pointer;
    transition: border-color 0.18s ease, background 0.18s ease, transform 0.18s ease;
  }

  .skill-resource-card[data-skill-detail-open]:hover,
  .skill-resource-card[data-skill-detail-open]:focus-visible {
    border-color: rgba(244, 242, 235, 0.28);
    background: rgba(255, 255, 255, 0.055);
    transform: translateY(-2px);
    outline: none;
  }

  .skill-resource-cover {
    position: relative;
    margin: 0;
    aspect-ratio: 16 / 11;
    overflow: hidden;
    background: #13140f;
  }

  .skill-resource-cover img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    filter: saturate(0.88);
  }

  .skill-resource-shade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(0, 0, 0, 0.14), rgba(0, 0, 0, 0.62)),
      radial-gradient(circle at 50% 0%, transparent, rgba(0, 0, 0, 0.28));
  }

  .skill-resource-content {
    padding: clamp(1.1rem, 2.2vw, 1.55rem);
  }

  .skill-resource-content h2 {
    margin: 0 0 0.65rem;
    color: rgba(244, 242, 235, 0.94);
    font-size: clamp(1.2rem, 1.85vw, 1.7rem);
    line-height: 1.15;
    letter-spacing: -0.05em;
  }

  .skill-resource-content h2 + p {
    min-height: 4.8rem;
    margin: 0;
    color: rgba(244, 242, 235, 0.62);
    font-size: 0.92rem;
    line-height: 1.78;
  }

  .skill-bottom-cta {
    display: grid;
    grid-template-areas:
      "title action"
      "copy action";
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    column-gap: clamp(1.5rem, 6vw, 6rem);
    margin-top: clamp(1rem, 2.8vw, 2rem);
    border: 1px solid rgba(244, 242, 235, 0.12);
    padding: clamp(1.35rem, 3vw, 2rem);
    background:
      radial-gradient(circle at 100% 0%, rgba(255, 255, 255, 0.1), transparent 18rem),
      rgba(255, 255, 255, 0.035);
  }

  .skill-bottom-cta h2 {
    grid-area: title;
    margin: 0;
    color: rgba(244, 242, 235, 0.94);
    font-size: clamp(1.5rem, 2.8vw, 2.6rem);
    line-height: 1.12;
    letter-spacing: -0.055em;
  }

  .skill-bottom-cta span {
    grid-area: copy;
    display: block;
    max-width: 720px;
    margin: 0.85rem 0 0;
    color: rgba(244, 242, 235, 0.6);
    line-height: 1.8;
  }

  .skill-bottom-cta .skill-button {
    grid-area: action;
    justify-self: end;
    min-width: 9rem;
  }

  .skill-popup-dialog {
    width: min(1180px, calc(100vw - 48px));
    max-height: calc(100dvh - 64px);
    padding: 0;
    overflow: hidden;
    border: 1px solid rgba(244, 242, 235, 0.14);
    border-radius: 4px;
    background: #191a17;
    color: #f4f2eb;
    box-shadow: 0 2rem 7rem rgba(0, 0, 0, 0.68);
    scrollbar-color: rgba(244, 242, 235, 0.26) transparent;
    scrollbar-width: thin;
  }

  .skill-popup-dialog::backdrop {
    background: rgba(0, 0, 0, 0.74);
    backdrop-filter: blur(2px);
  }

  .skill-popup-dialog::-webkit-scrollbar {
    width: 6px;
  }

  .skill-popup-dialog::-webkit-scrollbar-thumb {
    border-radius: 999px;
    background: rgba(244, 242, 235, 0.24);
  }

  .skill-popup-close {
    position: absolute;
    top: 1rem;
    right: 1rem;
    z-index: 2;
    display: inline-flex;
    width: 2.35rem;
    height: 2.35rem;
    align-items: center;
    justify-content: center;
    border: 1px solid transparent;
    border-radius: 999px;
    color: rgba(244, 242, 235, 0.88);
    background: transparent;
    cursor: pointer;
  }

  .skill-popup-close:hover,
  .skill-popup-close:focus-visible {
    border-color: rgba(244, 242, 235, 0.18);
    background: rgba(255, 255, 255, 0.06);
    outline: none;
  }

  .skill-popup-close svg {
    width: 1.15rem;
    height: 1.15rem;
  }

  .skill-popup-layout {
    display: grid;
    grid-template-columns: minmax(0, 1.45fr) minmax(340px, 0.9fr);
    gap: clamp(1.25rem, 2.2vw, 2rem);
    padding: clamp(1.35rem, 2.4vw, 2rem);
  }

  .skill-popup-media {
    display: grid;
    min-width: 0;
    gap: 0.8rem;
  }

  .skill-popup-stage {
    position: relative;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    height: clamp(290px, 50dvh, 430px);
    min-height: 0;
    overflow: hidden;
    border: 1px solid rgba(244, 242, 235, 0.12);
    background: #0f100d;
  }

  .skill-popup-stage figure,
  .skill-popup-pair-image {
    position: relative;
    min-width: 0;
    margin: 0;
    overflow: hidden;
    background: #0e0f0c;
  }

  .skill-popup-preview-trigger {
    width: 100%;
    height: 100%;
    display: block;
    border: 0;
    padding: 0;
    color: inherit;
    background: transparent;
    cursor: zoom-in;
  }

  .skill-popup-preview-trigger:focus-visible {
    outline: 2px solid rgba(244, 242, 235, 0.82);
    outline-offset: -4px;
  }

  .skill-popup-stage figure:first-child {
    border-right: 1px solid rgba(244, 242, 235, 0.42);
  }

  .skill-popup-stage span {
    position: absolute;
    top: 0.85rem;
    left: 0.85rem;
    z-index: 1;
    display: inline-flex;
    min-height: 1.5rem;
    align-items: center;
    border-radius: 999px;
    padding: 0 0.55rem;
    color: rgba(244, 242, 235, 0.92);
    background: rgba(0, 0, 0, 0.34);
    font-size: 0.76rem;
    font-weight: 800;
  }

  .skill-popup-stage img,
  .skill-popup-strip img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }

  .skill-popup-stage figure:first-child img {
    filter: saturate(0.74) brightness(0.8);
  }

  .skill-popup-arrow {
    position: absolute;
    top: 50%;
    left: 50%;
    z-index: 2;
    display: inline-flex;
    width: 2.8rem;
    height: 2.8rem;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(244, 242, 235, 0.66);
    border-radius: 999px;
    color: #f4f2eb;
    background: rgba(25, 26, 23, 0.74);
    font-size: 1.45rem;
    padding: 0;
    transform: translate(-50%, -50%);
  }

  .skill-popup-strip {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.7rem;
  }

  .skill-popup-pair-trigger {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.28rem;
    aspect-ratio: 16 / 7;
    border: 1px solid rgba(244, 242, 235, 0.1);
    padding: 0.28rem;
    background: rgba(255, 255, 255, 0.035);
    cursor: zoom-in;
  }

  .skill-popup-pair-trigger:hover,
  .skill-popup-pair-trigger:focus-visible {
    border-color: rgba(244, 242, 235, 0.32);
    background: rgba(255, 255, 255, 0.06);
    outline: none;
  }

  .skill-popup-pair-image {
    display: block;
  }

  .skill-popup-info {
    display: grid;
    align-content: center;
    min-width: 0;
    padding: clamp(1rem, 2vw, 1.4rem) clamp(0.2rem, 1.1vw, 0.85rem);
  }

  .skill-popup-info h2 {
    margin: 0;
    color: rgba(244, 242, 235, 0.96);
    font-size: clamp(1.75rem, 2.6vw, 2.35rem);
    line-height: 1.12;
    font-weight: 900;
  }

  .skill-popup-info > p {
    margin: 0.85rem 0 1.15rem;
    color: rgba(244, 242, 235, 0.62);
    line-height: 1.8;
  }

  .skill-popup-version {
    display: grid;
    gap: 0.8rem;
    padding: 1rem 0;
    border-top: 1px solid rgba(244, 242, 235, 0.1);
    border-bottom: 1px solid rgba(244, 242, 235, 0.1);
  }

  .skill-popup-version > span,
  .skill-popup-details dt {
    color: rgba(244, 242, 235, 0.72);
    font-size: 0.86rem;
    font-weight: 850;
  }

  .skill-popup-version div {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.7rem;
  }

  .skill-popup-version button {
    min-height: 2.45rem;
    border: 1px solid rgba(244, 242, 235, 0.16);
    border-radius: 999px;
    color: rgba(244, 242, 235, 0.72);
    background: transparent;
    font: inherit;
    font-size: 0.88rem;
    font-weight: 850;
    cursor: pointer;
  }

  .skill-popup-version button.active,
