---
import type { GetStaticPaths } from "astro";
import PortalShell from "../../layouts/PortalShell.astro";
import { skillModules } from "../../data/skill-modules";
import type { SkillModule } from "../../data/skill-modules";

export const getStaticPaths = (() =>
  skillModules.map((module) => ({
    params: { slug: module.slug },
    props: { module }
  }))) satisfies GetStaticPaths;

const { module } = Astro.props as { module: SkillModule };
---

<PortalShell
  activePage="market"
  title={module.name}
  description={module.summary}
  hideFooter={true}
>
  <section class="skill-detail" aria-labelledby="skillDetailTitle">
    <div class="skill-detail-inner">
      <div class="skill-routebar" aria-label="当前位置">
        <a href="/#sf-achievements" data-portal-route>返回 AI 实战库</a>
        <span>{module.name}</span>
      </div>

      <div class="skill-hero" data-skill-detail-hero>
        <div class="skill-hero-copy">
          <p class="skill-kicker">{module.eyebrow}</p>
          <h1 id="skillDetailTitle">{module.headline}</h1>
          <p class="skill-summary">{module.summary}</p>

          <dl class="skill-meta">
            <div>
              <dt>模块方向</dt>
              <dd>{module.job}</dd>
            </div>
            <div>
              <dt>核心状态</dt>
              <dd>{module.stat}</dd>
            </div>
            <div>
              <dt>适用方式</dt>
              <dd>可沟通定制</dd>
            </div>
          </dl>

          <div class="skill-actions">
            <a class="skill-button primary" href="/#sf-counter" data-portal-route>微信沟通</a>
            <a class="skill-button ghost" href="/#sf-achievements" data-portal-route>返回实战库</a>
          </div>
        </div>

        <figure class="skill-visual">
          <figcaption>
            <span>▧ Image</span>
            <span>720 × 960</span>
          </figcaption>
          <div class="skill-visual-frame">
            <img src={module.image} alt={`${module.name} 视觉封面`} loading="eager" />
          </div>
        </figure>
      </div>

      <section class="skill-highlight-strip" aria-label="模块重点">
        {module.highlights.map((item, index) => (
          <article>
            <span>{String(index + 1).padStart(2, "0")}</span>
            <strong>{item}</strong>
          </article>
        ))}
      </section>

      <div class="skill-panels" aria-label={`${module.name} 详情`}>
        <section class="skill-panel">
          <p>你会拿到</p>
          <h2>后续可以沉淀成资产的内容</h2>
          <ul>
            {module.deliverables.map((item) => <li>{item}</li>)}
          </ul>
        </section>

        <section class="skill-panel wide">
          <p>执行路径</p>
          <h2>从问题到可复用框架</h2>
          <ol>
            {module.flow.map((item, index) => (
              <li>
                <span>{String(index + 1).padStart(2, "0")}</span>
                <strong>{item}</strong>
              </li>
            ))}
          </ol>
        </section>

        <section class="skill-panel contact">
          <p>下一步</p>
          <h2>把你的产品、类目和当前卡点发我</h2>
          <p class="skill-contact-copy">
            我会先帮你判断从视觉、视频、自动化还是定制 Skill 切入，让这个模块真的能接到你的业务里。
          </p>
          <a class="skill-button primary" href="/#sf-counter" data-portal-route>去微信联系</a>
        </section>
      </div>
    </div>
  </section>
</PortalShell>

<style>
  .skill-detail {
    min-height: calc(100svh - var(--portal-floating-nav-clearance));
    color: #f4f2eb;
    background:
      radial-gradient(circle at 50% 0%, rgba(255, 255, 255, 0.075), transparent 30rem),
      linear-gradient(180deg, #050604 0%, #090a07 54%, #11130e 100%);
    padding: clamp(2.2rem, 5vw, 4.8rem) clamp(1rem, 4vw, 4rem) clamp(4rem, 7vw, 7rem);
  }

  .skill-detail-inner {
    width: min(1240px, 100%);
    margin: 0 auto;
  }

  .skill-routebar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 2.85rem;
    border-bottom: 1px solid rgba(244, 242, 235, 0.1);
    color: rgba(244, 242, 235, 0.44);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  .skill-routebar a {
    color: rgba(244, 242, 235, 0.72);
    text-decoration: none;
  }

  .skill-routebar a::before {
    content: "←";
    margin-right: 0.45rem;
  }

  .skill-routebar span {
    color: rgba(244, 242, 235, 0.52);
    text-align: right;
  }

  .skill-hero {
    display: grid;
    grid-template-columns: minmax(0, 1.04fr) minmax(280px, 0.72fr);
    gap: clamp(2rem, 5.5vw, 5.6rem);
    align-items: center;
    padding: clamp(3.4rem, 7vw, 6.5rem) 0 clamp(2.4rem, 4vw, 4rem);
  }

  .skill-kicker,
  .skill-panel > p {
    margin: 0 0 1rem;
    color: rgba(244, 242, 235, 0.48);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .skill-hero h1 {
    max-width: 860px;
    margin: 0;
    font-family: "Noto Serif SC", "Songti SC", "STSong", "SimSun", ui-serif, Georgia, serif;
    font-size: clamp(3.15rem, 7.1vw, 7.1rem);
    font-weight: 400;
    line-height: 1.02;
    letter-spacing: -0.075em;
  }

  .skill-summary {
    max-width: 620px;
    margin: 1.65rem 0 0;
    color: rgba(244, 242, 235, 0.62);
    font-size: clamp(1rem, 1.35vw, 1.18rem);
    line-height: 1.9;
  }

  .skill-meta {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    max-width: 690px;
    margin: clamp(1.8rem, 3vw, 2.6rem) 0 0;
    border-top: 1px solid rgba(244, 242, 235, 0.12);
    border-bottom: 1px solid rgba(244, 242, 235, 0.12);
  }

  .skill-meta div {
    min-height: 5.4rem;
    padding: 1rem 1rem 1rem 0;
  }

  .skill-meta div + div {
    padding-left: 1rem;
    border-left: 1px solid rgba(244, 242, 235, 0.12);
  }

  .skill-meta dt,
  .skill-meta dd {
    margin: 0;
  }

  .skill-meta dt {
    color: rgba(244, 242, 235, 0.42);
    font-size: 0.76rem;
    font-weight: 800;
    letter-spacing: 0.12em;
  }

  .skill-meta dd {
    margin-top: 0.65rem;
    color: rgba(244, 242, 235, 0.88);
    font-size: clamp(1rem, 1.55vw, 1.26rem);
    font-weight: 700;
  }

  .skill-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-top: 2.2rem;
  }

  .skill-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 3rem;
    border-radius: 999px;
    padding: 0 1.25rem;
    font-size: 0.92rem;
    font-weight: 700;
    text-decoration: none;
    transition: transform 0.18s ease, border-color 0.18s ease, background 0.18s ease;
  }

  .skill-button:hover {
    transform: translateY(-1px);
  }

  .skill-button.primary {
    color: #0a0b08;
    background: #f7f5ee;
  }

  .skill-button.ghost {
    color: rgba(244, 242, 235, 0.78);
    border: 1px solid rgba(244, 242, 235, 0.18);
    background: rgba(255, 255, 255, 0.04);
  }

  .skill-visual {
    margin: 0;
    justify-self: end;
    width: min(420px, 100%);
  }

  .skill-visual figcaption {
    display: flex;
    justify-content: space-between;
    margin-bottom: 0.55rem;
    color: rgba(244, 242, 235, 0.35);
    font-size: 0.74rem;
    font-weight: 700;
  }

  .skill-visual-frame {
    position: relative;
    overflow: hidden;
    aspect-ratio: 3 / 4;
    border: 1px solid rgba(244, 242, 235, 0.14);
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.06), rgba(255, 255, 255, 0.015)),
      #12130f;
    box-shadow: 0 1.8rem 5rem rgba(0, 0, 0, 0.42);
  }

  .skill-visual-frame img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: contain;
  }

  .skill-highlight-strip {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1px;
    overflow: hidden;
    margin-bottom: clamp(1.2rem, 2.8vw, 2rem);
    border: 1px solid rgba(244, 242, 235, 0.11);
    background: rgba(244, 242, 235, 0.11);
  }

  .skill-highlight-strip article {
    min-height: clamp(6.4rem, 9vw, 8.4rem);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: clamp(1rem, 2vw, 1.4rem);
    background: rgba(255, 255, 255, 0.035);
  }

  .skill-highlight-strip span {
    color: rgba(244, 242, 235, 0.36);
    font: 800 0.72rem/1 ui-monospace, SFMono-Regular, Consolas, monospace;
  }

  .skill-highlight-strip strong {
    color: rgba(244, 242, 235, 0.86);
    font-size: clamp(1rem, 1.35vw, 1.18rem);
    line-height: 1.35;
  }

  .skill-panels {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: 1rem;
  }

  .skill-panel {
    border: 1px solid rgba(244, 242, 235, 0.1);
    padding: clamp(1.3rem, 3vw, 2rem);
    background: rgba(255, 255, 255, 0.035);
  }

  .skill-panel.wide {
    grid-row: span 2;
  }

  .skill-panel.contact {
    min-height: 17rem;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: space-between;
    background:
      radial-gradient(circle at 100% 0%, rgba(255, 255, 255, 0.12), transparent 16rem),
      rgba(255, 255, 255, 0.055);
  }

  .skill-panel h2 {
    margin: 0 0 1.4rem;
    color: rgba(244, 242, 235, 0.92);
    font-size: clamp(1.25rem, 2.1vw, 2rem);
    font-weight: 700;
    letter-spacing: -0.04em;
  }

  .skill-panel ul,
  .skill-panel ol {
    display: grid;
    gap: 0.72rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .skill-panel li {
    color: rgba(244, 242, 235, 0.72);
    line-height: 1.7;
  }

  .skill-panel ul li {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }

  .skill-panel ul li::before {
    content: "";
    width: 0.38rem;
    height: 0.38rem;
    border-radius: 999px;
    background: rgba(244, 242, 235, 0.68);
    flex: 0 0 auto;
  }

  .skill-panel ol {
    grid-template-columns: 1fr;
  }

  .skill-panel ol li {
    display: grid;
    grid-template-columns: 3.2rem minmax(0, 1fr);
    gap: 1rem;
    align-items: start;
    min-height: auto;
    border-top: 1px solid rgba(244, 242, 235, 0.12);
    padding-top: 1rem;
  }

  .skill-panel ol span {
    display: block;
    margin: 0;
    color: rgba(244, 242, 235, 0.38);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.08em;
  }

  .skill-panel ol strong {
    color: rgba(244, 242, 235, 0.88);
    font-size: clamp(1rem, 1.45vw, 1.22rem);
    line-height: 1.45;
  }

  .skill-contact-copy {
    margin: -0.3rem 0 1.4rem;
    color: rgba(244, 242, 235, 0.62);
    font-size: 0.98rem;
    line-height: 1.85;
  }

  @media (max-width: 860px) {
    .skill-detail {
      padding-top: 1.8rem;
    }

    .skill-hero,
    .skill-highlight-strip,
    .skill-panels {
      grid-template-columns: 1fr;
    }

    .skill-hero {
      gap: 2.5rem;
      padding-top: 3.5rem;
    }

    .skill-hero h1 {
      font-size: clamp(2.65rem, 13vw, 4.4rem);
      letter-spacing: -0.07em;
    }

    .skill-meta {
      grid-template-columns: 1fr;
    }

    .skill-meta div + div {
      padding-left: 0;
      border-left: 0;
      border-top: 1px solid rgba(244, 242, 235, 0.12);
    }

    .skill-visual {
      max-width: 360px;
      margin: 0 auto;
      justify-self: center;
    }

    .skill-panel.wide {
      grid-row: auto;
    }

    .skill-routebar {
      align-items: flex-start;
      flex-direction: column;
      padding-bottom: 0.85rem;
    }
  }
</style>
