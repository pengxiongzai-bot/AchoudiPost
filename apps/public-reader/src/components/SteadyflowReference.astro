  .sf-phone-header,
  .sf-stat-summary,
  .sf-habits-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .sf-phone-header {
    padding: 0 2px 13px;
  }

  .sf-phone-header h3 {
    margin: 0 0 3px;
    font-family: var(--sf-headline);
    font-size: 20px;
    font-weight: 500;
  }

  .sf-phone-header p {
