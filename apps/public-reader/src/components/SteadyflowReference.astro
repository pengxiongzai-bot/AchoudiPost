---
const counterVideo =
  "https://d8j0ntlcm91z4.cloudfront.net/user_38xzZboKViGWJOttwIXH07lWA1P/hf_20260625_213350_6343fcfb-2892-4dcc-8573-1161447cacf5.mp4";

const moduleTokens = ["图", "视", "流"];

const moduleCards = [
  {
    name: "AI 生图 Skill",
    job: "商品视觉",
    stat: "6 个场景",
    description: "主图、场景图、卖点图，先把商品视觉做成可复用框架。",
    href: "/market/",
    image:
      "https://images.higgs.ai/?default=1&output=webp&url=https%3A%2F%2Fd8j0ntlcm91z4.cloudfront.net%2Fuser_38xzZboKViGWJOttwIXH07lWA1P%2Fhf_20260625_213624_40d877b4-92a9-44d3-be3c-5d3332db4402.png&w=1280&q=85"
  },
  {
    name: "AI 生视频 Skill",
    job: "短视频素材",
    stat: "起量入口",
    description: "从脚本、镜头到转场，围绕电商短视频先解决素材效率。",
    href: "/market/",
    image:
      "https://images.higgs.ai/?default=1&output=webp&url=https%3A%2F%2Fd8j0ntlcm91z4.cloudfront.net%2Fuser_38xzZboKViGWJOttwIXH07lWA1P%2Fhf_20260625_213908_9574cadd-4c04-4380-af84-a753e484415a.png&w=1280&q=85"
  },
  {
    name: "商品内容框架",
    job: "文案卖点",
    stat: "40+ 模板",
    description: "标题、详情页、直播话术，把卖点讲清楚再去放大流量。",
    href: "/articles/",
    image:
      "https://images.higgs.ai/?default=1&output=webp&url=https%3A%2F%2Fd8j0ntlcm91z4.cloudfront.net%2Fuser_38xzZboKViGWJOttwIXH07lWA1P%2Fhf_20260625_213950_c1686b87-f412-4878-b7fe-96ba5085ba01.png&w=1280&q=85"
  },
  {
    name: "私域成交路径",
    job: "微信承接",
    stat: "3 步转化",
    description: "从公开内容到加微交付，让用户知道下一步该点哪里。",
    href: "/about/",
    image:
      "https://images.higgs.ai/?default=1&output=webp&url=https%3A%2F%2Fd8j0ntlcm91z4.cloudfront.net%2Fuser_38xzZboKViGWJOttwIXH07lWA1P%2Fhf_20260625_214012_f14ffda8-1f1c-48bc-893f-1ad05f6bc2d9.png&w=1280&q=85"
  },
  {
    name: "电商工具流",
    job: "资源工具",
    stat: "常用清单",
    description: "图片、视频、运营和内容工具，按任务快速找到对应入口。",
    href: "/tools/",
    image:
      "https://images.higgs.ai/?default=1&output=webp&url=https%3A%2F%2Fd8j0ntlcm91z4.cloudfront.net%2Fuser_38xzZboKViGWJOttwIXH07lWA1P%2Fhf_20260625_214103_cadf49e5-cae8-42e2-9bec-955b7347f850.png&w=1280&q=85"
  },
  {
    name: "飞书知识库",
    job: "长期更新",
    stat: "持续沉淀",
    description: "课程、案例、素材和说明统一放进知识库，方便反复回来用。",
    href: "/guide/",
    image:
      "https://images.higgs.ai/?default=1&output=webp&url=https%3A%2F%2Fd8j0ntlcm91z4.cloudfront.net%2Fuser_38xzZboKViGWJOttwIXH07lWA1P%2Fhf_20260625_214142_c7344da9-f597-42b7-8c31-7ca5228503fb.png&w=1280&q=85"
  }
];

const impactStats = [
  { value: "生图框架", label: "商品主图、场景图、卖点图" },
  { value: "生视频框架", label: "短视频开头、镜头转场、产品展示" },
  { value: "成交流程", label: "内容种草、私域承接、交付路径" }
];

const heroGalleryCards = moduleCards.slice(0, 5);
const tripledModuleCards = [...moduleCards, ...moduleCards, ...moduleCards];
---

<section class="sf-reference" data-steadyflow-reference aria-label="AchoudiPost 首屏参考块">
  <div class="sf-frame">
    <section class="sf-hero sf-studio-hero" id="sf-hero" aria-labelledby="sfHeroTitle">
      <div class="sf-studio-copy">
        <p class="sf-studio-eyebrow sf-rise" style="--delay: .08s">AI COMMERCE SKILL STUDIO</p>
        <h2 id="sfHeroTitle" class="sf-rise" style="--delay: .16s">电商 AI<br />实战 Skill<br />工作室</h2>
      </div>

      <div class="sf-studio-gallery sf-rise" style="--delay: .26s" aria-label="电商 AI 实战模块预览">
        {heroGalleryCards.map((card, index) => (
          <a class:list={["sf-studio-card", `sf-studio-card-${index + 1}`]} href={card.href} data-portal-route aria-label={`查看 ${card.name}`}>
            <img src={card.image} alt="" loading={index > 1 ? "lazy" : "eager"} />
            <span>
              <strong>{card.name}</strong>
              <small>{card.job}</small>
            </span>
          </a>
        ))}
      </div>

      <div class="sf-studio-bottom sf-rise" style="--delay: .36s">
        <p>这里整理电商 AI 生图、生视频、商品内容和私域成交里的可复用 Skill 框架。少走弯路，直接看能落地的内容。</p>
        <div class="sf-hero-ctas">
          <a class="sf-primary-cta" href="/market/" data-portal-route>进入 AI 实战库</a>
          <a class="sf-secondary-cta" href="/articles/" data-portal-route>查看文章</a>
        </div>
      </div>
    </section>

    <section class="sf-achievements" id="sf-achievements" aria-labelledby="sfModulesHeading">
      <div class="sf-achievements-header sf-reveal">
        <div class="sf-achievements-title">
          <p class="sf-section-kicker">MODULE MAP</p>
          <h2 id="sfModulesHeading">先从这些实战模块进入</h2>
        </div>
        <div class="sf-avatar-strip">
          <div class="sf-avatar-stack" aria-hidden="true">
            {moduleTokens.map((token) => <span class="sf-module-token">{token}</span>)}
            <div class="sf-avatar-count"><span data-sf-avatar-count data-sf-counts="6+,7+,8+,9+">6+</span></div>
          </div>
          <div class="sf-loved-copy">
            <div class="sf-star-row" aria-hidden="true">★★★★★</div>
            <span>点进去看详细内容</span>
          </div>
        </div>
      </div>

      <div class="sf-marquee-container sf-reveal">
        <div class="sf-marquee-track">
          {tripledModuleCards.map((card, index) => (
            <a class="sf-achievement-card" href={card.href} data-portal-route aria-label={`查看 ${card.name}`}>
              <img src={card.image} alt="" loading={index > 3 ? "lazy" : "eager"} />
              <div class="sf-card-gradient"></div>
              <div class="sf-card-content">
                <div class="sf-card-person">
                  <span>{card.name}</span>
                  <span class="sf-card-dot">·</span>
                  <span class="sf-card-job">{card.job}</span>
                </div>
                <div class="sf-card-result">
                  <span class="sf-card-kicker">点击进入</span>
                  <strong>{card.stat}</strong>
                  <p>{card.description}</p>
                </div>
                <span class="sf-card-link-hint">查看详细内容 →</span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="sf-counter sf-reveal" id="sf-counter" aria-labelledby="sfCounterHeading">
      <div class="sf-counter-copy">
        <div class="sf-counter-pill">Skill Library</div>
        <h2 id="sfCounterHeading">一个电商 AI 实战框架，会比一堆零散提示词更有用</h2>
        <strong class="sf-giant-number">3+</strong>
        <p>核心实战方向正在持续沉淀</p>
      </div>

      <div class="sf-counter-visual">
        <div class="sf-earth-stage">
          <div class="sf-counter-video-frame">
            <video src={counterVideo} autoplay muted loop playsinline aria-hidden="true"></video>
            <div class="sf-counter-fade"></div>
            <div class="sf-cloud-overlay" aria-hidden="true"></div>
          </div>
          <div class="sf-blur-slab"></div>
        </div>

        <div class="sf-impact-stats" aria-label="AchoudiPost 实战方向">
          {impactStats.map((stat) => (
            <div class="sf-impact-stat">
              <strong>{stat.value}</strong>
              <p>{stat.label}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

  </div>
</section>

<script is:inline type="module" src="/scripts/steadyflow-reference.js"></script>

<style>
  @import url("https://fonts.googleapis.com/css2?family=Google+Sans+Flex:wght@500&display=swap");

  @font-face {
    font-family: "Stack Sans Headline";
    src: url("https://framerusercontent.com/modules/VqG9xS8K2qN3B8RHWMKb/UQYzREmGJ3JWCi77B0rN/StackSans-Medium.woff2")
      format("woff2");
    font-weight: 500;
    font-style: normal;
    font-display: swap;
  }

  .sf-reference {
    --sf-page-bg: rgb(247, 247, 247);
    --sf-ink: rgb(19, 21, 21);
    --sf-blue: #4382bc;
    --sf-logo: #5bb8f0;
    --sf-muted: rgb(73, 77, 77);
    --sf-headline: "Stack Sans Headline", sans-serif;
    --sf-ui: "Google Sans Flex", sans-serif;
    position: relative;
    overflow: hidden;
    background: var(--sf-page-bg);
    color: var(--sf-ink);
    font-family: var(--sf-ui);
    font-weight: 500;
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
  }

  .sf-reference *,
  .sf-reference *::before,
  .sf-reference *::after {
    box-sizing: border-box;
  }

  .sf-reference a {
    color: inherit;
    text-decoration: none;
  }

  .sf-reference button {
    color: inherit;
    font: inherit;
  }

  .sf-frame {
    position: relative;
    overflow: hidden;
    background: var(--sf-page-bg);
  }

  .sf-navbar-wrap {
    position: fixed;
    top: 0;
    right: 0;
    left: 0;
    z-index: 80;
    padding: 30px;
    pointer-events: none;
  }

  .sf-desktop-navbar {
    display: flex;
    width: 100%;
    max-width: 1260px;
    justify-content: space-between;
    gap: 0;
    margin: 0 auto;
    pointer-events: auto;
    transition: gap 0.45s cubic-bezier(0.44, 0, 0.56, 1), justify-content 0.45s cubic-bezier(0.44, 0, 0.56, 1);
  }

  .sf-nav-pill {
    display: flex;
    align-items: center;
    border-radius: 20px;
    background: #fff;
    box-shadow: 0 8px 20px rgba(5, 8, 12, 0.1);
    transition: box-shadow 0.25s ease, transform 0.25s ease;
  }

  .sf-scrolled .sf-nav-pill {
    box-shadow: 0 12px 34px rgba(5, 8, 12, 0.14);
  }

  .sf-brand-pill {
    min-width: 216px;
    gap: 12px;
    padding: 12px 18px 12px 12px;
    color: var(--sf-ink);
  }

  .sf-achoudi-mark {
    position: relative;
    width: 38px;
    height: 38px;
    display: grid;
    place-items: center;
    flex: 0 0 auto;
    border: 1px solid var(--sf-ink);
    border-radius: 50%;
    background: var(--sf-ink);
    color: #fff;
    font-family: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    font-size: 17px;
    font-weight: 900;
    letter-spacing: -0.04em;
  }

  .sf-achoudi-mark::after {
    content: "";
    position: absolute;
    right: -2px;
    bottom: -2px;
    width: 8px;
    height: 8px;
    border: 2px solid #fff;
    border-radius: 50%;
    background: #97c731;
  }

  .sf-compact-mark {
    width: 32px;
    height: 32px;
    font-size: 15px;
  }

  .sf-brand-copy {
    display: flex;
    min-width: 0;
    flex-direction: column;
    gap: 2px;
  }

  .sf-brand-copy strong {
    font-family: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    font-size: 17px;
    font-weight: 850;
    letter-spacing: -0.03em;
    line-height: 1;
  }

  .sf-brand-copy small {
    color: var(--sf-muted);
    font-size: 11px;
    line-height: 1.1;
  }

  .sf-nav-menu {
    height: 64px;
    gap: 32px;
    padding: 0 32px;
    font-size: 14px;
  }

  .sf-nav-menu .nav-link {
    height: 100%;
    display: inline-flex;
    align-items: center;
    padding: 0;
    color: color-mix(in srgb, var(--sf-ink) 72%, transparent);
    font-weight: 700;
    line-height: 1;
    white-space: nowrap;
    transition: color 0.2s ease, opacity 0.2s ease;
  }

  .sf-nav-menu .nav-link::after,
  .sf-mobile-menu-panel .nav-link::after {
    display: none;
  }

  .sf-nav-menu .nav-link:hover,
  .sf-nav-menu .nav-link.active {
    color: var(--sf-ink);
  }

  .sf-action-pill {
    min-width: 216px;
    justify-content: flex-end;
    gap: 12px;
    padding: 6px 6px 6px 16px;
  }

  .sf-service-pulse {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--sf-muted);
    font-family: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    font-size: 12px;
    font-weight: 750;
    white-space: nowrap;
  }

  .sf-service-pulse span {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #b8b8b8;
    box-shadow: 0 0 0 0 rgba(151, 199, 49, 0);
  }

  .sf-service-pulse[data-status="online"] span {
    background: #97c731;
    box-shadow: 0 0 0 6px rgba(151, 199, 49, 0.12);
  }

  .sf-service-pulse[data-status="offline"] span {
    background: #e17a71;
    box-shadow: 0 0 0 6px rgba(225, 122, 113, 0.12);
  }

  .sf-service-pulse b {
    font-weight: 750;
  }

  .sf-icon-button {
    display: grid;
    width: 52px;
    height: 52px;
    place-items: center;
    padding: 0;
    border: 0;
    border-radius: 14px;
    background: var(--sf-ink);
    color: #fff;
    transition: transform 0.45s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .sf-icon-button:hover,
  .sf-primary-cta:hover,
  .sf-secondary-cta:hover {
    transform: scale(0.95);
  }

  .sf-icon-button svg {
    width: 21px;
    height: 21px;
    stroke-width: 1.8;
  }

  .sf-mobile-navbar,
  .sf-mobile-menu-backdrop {
    display: none;
  }

  .sf-hero {
    position: relative;
    display: flex;
    width: 100%;
    min-height: 860px;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    overflow: hidden;
    padding: clamp(130px, 13vw, 164px) 0 76px;
    background:
      linear-gradient(180deg, #fff 0%, #fff 72%, var(--sf-page-bg) 100%),
      #fff;
    color: var(--sf-ink);
    text-align: center;
  }

  .sf-studio-copy {
    display: flex;
    width: min(900px, calc(100% - 40px));
    flex-direction: column;
    align-items: center;
    gap: 14px;
    margin: 0 auto;
  }

  .sf-rise {
    opacity: 0;
    transform: translateY(20px);
    animation: sf-rise 0.6s var(--delay, 0s) cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }

  @keyframes sf-rise {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .sf-studio-eyebrow,
  .sf-studio-bottom p,
  .sf-counter-copy > p,
  .sf-impact-stat p {
    margin: 0;
  }

  .sf-studio-eyebrow {
    color: color-mix(in srgb, var(--sf-muted) 72%, transparent);
    font-size: 12px;
    font-weight: 850;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .sf-hero .sf-studio-copy h2 {
    max-width: 760px;
    margin: 0;
    font-family: var(--sf-headline);
    font-size: clamp(58px, 7.4vw, 106px);
    font-weight: 500;
    letter-spacing: -0.055em;
    line-height: 0.9;
    text-wrap: balance;
  }

  .sf-studio-gallery {
    display: grid;
    width: min(1280px, 100%);
    grid-template-columns: repeat(5, minmax(160px, 1fr));
    gap: 12px;
    margin-top: 58px;
    padding: 0 10px;
  }

  .sf-studio-card {
    position: relative;
    height: clamp(170px, 20vw, 255px);
    overflow: hidden;
    border-radius: 3px;
    background: #e5e5e1;
    box-shadow: 0 24px 60px rgba(5, 8, 12, 0.1);
    transform-origin: center bottom;
    transition: transform 0.35s ease, box-shadow 0.35s ease, filter 0.35s ease;
  }

  .sf-studio-card img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.94) contrast(1.04);
  }

  .sf-studio-card::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(0, 0, 0, 0.02) 38%, rgba(0, 0, 0, 0.58) 100%);
    pointer-events: none;
  }

  .sf-studio-card span {
    position: absolute;
    right: 16px;
    bottom: 14px;
    left: 16px;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    color: #fff;
    text-align: left;
  }

  .sf-studio-card strong {
    font-size: 14px;
    font-weight: 850;
    line-height: 1.2;
  }

  .sf-studio-card small {
    margin-top: 3px;
    color: rgba(255, 255, 255, 0.72);
    font-size: 11px;
  }

  .sf-studio-card-1 {
    transform: translateY(10px) rotate(-2.4deg);
  }

  .sf-studio-card-2 {
    transform: translateY(2px) rotate(-0.9deg);
  }

  .sf-studio-card-4 {
    transform: translateY(2px) rotate(0.9deg);
  }

  .sf-studio-card-5 {
    transform: translateY(10px) rotate(2.4deg);
  }

  .sf-studio-card:hover {
    z-index: 2;
    box-shadow: 0 28px 80px rgba(5, 8, 12, 0.16);
    filter: saturate(1.04);
    transform: translateY(-8px) rotate(0deg);
  }

  .sf-studio-bottom {
    display: flex;
    width: min(620px, calc(100% - 40px));
    flex-direction: column;
    align-items: center;
    gap: 18px;
    margin: 54px auto 0;
  }

  .sf-studio-bottom p {
    color: var(--sf-muted);
    font-size: 15px;
    line-height: 1.7;
    text-wrap: balance;
  }

  .sf-hero-ctas {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-top: 0;
  }

  .sf-primary-cta,
  .sf-secondary-cta {
    display: inline-flex;
    height: 54px;
    align-items: center;
    justify-content: center;
    border: 0;
    border-radius: 999px;
    font-size: 16px;
    cursor: pointer;
    transition: transform 0.45s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .sf-primary-cta {
    padding: 16px 34px;
    background: var(--sf-ink);
    color: #fff;
  }

  .sf-secondary-cta {
    padding: 0 28px;
    border: 1px solid rgba(19, 21, 21, 0.14);
    background: #fff;
    color: var(--sf-ink);
  }

  .sf-video-overlay {
    position: fixed;
    z-index: 100;
    inset: 0;
    display: grid;
    place-items: center;
    padding: 30px;
    background: rgba(19, 21, 21, 0.9);
  }

  .sf-video-overlay[hidden],
  .sf-mobile-menu-backdrop[hidden] {
    display: none;
  }

  .sf-modal-close {
    position: absolute;
    top: 30px;
    right: 30px;
    width: 40px;
    height: 40px;
    border: 0;
    border-radius: 8px;
    background: rgb(247, 247, 247);
    cursor: pointer;
  }

  .sf-modal-close span {
    position: absolute;
    top: 19px;
    left: 10px;
    width: 20px;
    height: 2px;
    border-radius: 2px;
    background: var(--sf-ink);
    transform: rotate(45deg);
  }

  .sf-modal-close span:last-child {
    transform: rotate(-45deg);
  }

  .sf-video-panel {
    width: min(800px, 100%);
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: 20px;
    background: #000;
    box-shadow: 0 40px 100px rgba(0, 0, 0, 0.5);
  }

  .sf-video-panel iframe {
    width: 100%;
    height: 100%;
    border: 0;
  }

  .sf-achievements {
    overflow: hidden;
    padding-top: 200px;
    background: var(--sf-page-bg);
  }

  .sf-achievements-header {
    display: flex;
    max-width: 1260px;
    align-items: flex-end;
    justify-content: space-between;
    gap: 60px;
    margin: 0 auto;
    padding: 0 30px;
  }

  .sf-achievements-title {
    flex: 0.7;
  }

  .sf-achievements h2,
  .sf-counter h2 {
    margin: 0;
    font-family: var(--sf-headline);
    font-size: 48px;
    font-weight: 500;
    letter-spacing: -0.035em;
    line-height: 1.2;
    text-wrap: balance;
  }

