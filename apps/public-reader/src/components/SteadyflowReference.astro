  .sf-contact-card::before {
    position: absolute;
    inset: -18% -10%;
    background:
      linear-gradient(105deg, transparent 0 27%, rgba(247, 247, 241, 0.09) 27.2%, transparent 27.5%),
      linear-gradient(80deg, transparent 0 48%, rgba(247, 247, 241, 0.07) 48.2%, transparent 48.5%),
      linear-gradient(118deg, transparent 0 69%, rgba(247, 247, 241, 0.08) 69.2%, transparent 69.5%),
      linear-gradient(95deg, transparent 0 86%, rgba(247, 247, 241, 0.055) 86.2%, transparent 86.5%);
    content: "";
    opacity: 0.42;
    pointer-events: none;
    transform: rotate(-3deg);
    transition: opacity 0.3s ease;
