  .sf-contact-card::after {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    box-shadow:
      inset 0 1px 0 rgba(247, 247, 241, 0.065),
      inset 0 0 0 1px rgba(247, 247, 241, 0.025);
    content: "";
    pointer-events: none;
    transition: box-shadow 0.3s ease;
