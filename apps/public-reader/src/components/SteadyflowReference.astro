    transform: translateY(12px);
  }

  .sf-ai-workbench {
    position: relative;
    display: grid;
    width: min(640px, 100%);
    grid-template-columns: minmax(0, 1fr);
    justify-items: center;
    margin-top: clamp(90px, 9vw, 132px);
  }

  .sf-ai-preview-card {
    width: min(360px, 64vw);
    margin: 0;
    transform: translateY(30px) scale(0.985);
  }

  .sf-ai-media-label {
    display: flex;
    justify-content: space-between;
    margin-bottom: 10px;
    color: rgba(247, 247, 241, 0.46);
    font-size: 13px;
    font-weight: 650;
    letter-spacing: -0.02em;
    line-height: 1;
  }

  .sf-ai-preview-frame {
    position: relative;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    border: 2px solid #177fff;
    background: linear-gradient(180deg, rgba(247, 247, 241, 0.08), rgba(247, 247, 241, 0.02));
    box-shadow: 0 24px 80px rgba(0, 0, 0, 0.36);
  }

  .sf-ai-preview-frame::before,
  .sf-ai-preview-frame::after {
    position: absolute;
    z-index: 2;
    width: 8px;
    height: 8px;
    border-radius: 2px;
    background: #d7ecff;
    content: "";
  }

  .sf-ai-preview-frame::before {
    top: -5px;
    left: -5px;
  }

  .sf-ai-preview-frame::after {
    right: -5px;
    bottom: -5px;
  }

  .sf-ai-preview-frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: brightness(0.72) saturate(0.84);
  }

  .sf-ai-prompt-card {
    position: relative;
    z-index: 3;
    display: grid;
    width: 100%;
    justify-self: center;
    grid-template-rows: auto auto;
    gap: 20px;
    margin-top: -34px;
    padding: 18px 20px;
    overflow: hidden;
    border: 1px solid rgba(247, 247, 241, 0.13);
    border-radius: 22px;
    background: rgba(18, 18, 15, 0.86);
    box-shadow: 0 26px 80px rgba(0, 0, 0, 0.35);
    text-align: left;
    transform: translateY(34px) scale(0.94);
    backdrop-filter: blur(20px);
    transition: border-color 0.35s ease, box-shadow 0.35s ease, transform 0.35s ease;
    will-change: opacity, transform;
  }

  .sf-ai-prompt-card::before {
    position: absolute;
    inset: 0;
    background: linear-gradient(110deg, transparent 0%, rgba(247, 247, 241, 0.16) 44%, transparent 68%);
    content: "";
    opacity: 0;
    transform: translateX(-120%);
    pointer-events: none;
  }

  .sf-ai-prompt-card::after {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    box-shadow: inset 0 1px 0 rgba(247, 247, 241, 0.12);
    content: "";
    pointer-events: none;
  }

  .sf-ai-prompt-card:hover {
    border-color: rgba(247, 247, 241, 0.24);
    box-shadow: 0 30px 96px rgba(0, 0, 0, 0.42), 0 0 34px rgba(247, 247, 241, 0.08);
    transform: translateY(-3px) scale(1);
  }

  .sf-ai-prompt-main {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: 16px;
  }

  .sf-ai-prompt-tag {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 38px;
    padding: 0 13px;
    border-radius: 13px;
    background: rgba(247, 247, 241, 0.08);
    color: rgba(247, 247, 241, 0.9);
    font-size: 15px;
    font-weight: 800;
    letter-spacing: -0.02em;
    white-space: nowrap;
  }

  .sf-ai-tag-icon {
    display: grid;
    width: 22px;
    height: 22px;
    place-items: center;
    border-radius: 8px;
    background: rgba(247, 247, 241, 0.08);
    color: rgba(247, 247, 241, 0.68);
    font-size: 13px;
  }

  .sf-ai-prompt-main p {
    margin: 0;
    color: rgba(247, 247, 241, 0.92);
    font-size: 20px;
    font-weight: 650;
    letter-spacing: -0.025em;
    line-height: 1.35;
  }

  .sf-ai-prompt-actions {
    display: flex;
    align-items: center;
    gap: 14px;
    color: rgba(247, 247, 241, 0.55);
  }

  .sf-ai-soft-icon,
  .sf-ai-send-icon {
    display: grid;
    place-items: center;
    border-radius: 999px;
  }

  .sf-ai-soft-icon {
    width: 28px;
    height: 28px;
    border: 1px solid rgba(247, 247, 241, 0.12);
    font-size: 13px;
  }

  .sf-ai-send-icon {
    width: 38px;
    height: 38px;
    margin-left: auto;
    padding: 0;
    border: 0;
    appearance: none;
    background: rgba(247, 247, 241, 0.96);
    color: var(--sf-counter-bg);
    cursor: pointer;
    font-size: 20px;
    font-weight: 900;
    font-family: inherit;
    transition: transform 0.22s ease, background 0.22s ease, box-shadow 0.22s ease;
  }

  .sf-ai-send-icon:hover,
  .sf-ai-send-icon:focus-visible {
    background: #ffffff;
    box-shadow: 0 0 0 6px rgba(247, 247, 241, 0.08), 0 12px 28px rgba(0, 0, 0, 0.28);
    transform: translateY(-2px);
  }

  .sf-ai-send-icon:focus-visible {
    outline: 2px solid rgba(247, 247, 241, 0.92);
    outline-offset: 4px;
  }

  .sf-counter.sf-in-view .sf-section-kicker {
    opacity: 1;
    transform: none;
    filter: none;
    animation: sfContactFadeLift 0.52s cubic-bezier(0.22, 1, 0.36, 1) 0.08s backwards;
  }

  .sf-counter.sf-in-view h2 {
    opacity: 1;
    transform: none;
    filter: none;
    animation: sfContactTitleIn 0.82s cubic-bezier(0.18, 1, 0.32, 1) 0.18s backwards;
  }

  .sf-counter.sf-in-view .sf-section-copy span:first-child {
    opacity: 1;
    transform: none;
    filter: none;
    animation: sfContactFadeLift 0.52s cubic-bezier(0.22, 1, 0.36, 1) 0.62s backwards;
  }

  .sf-counter.sf-in-view .sf-section-copy span:last-child {
    opacity: 1;
    transform: none;
    filter: none;
    animation: sfContactFadeLift 0.52s cubic-bezier(0.22, 1, 0.36, 1) 0.76s backwards;
  }

  .sf-counter.sf-in-view .sf-ai-preview-card {
    opacity: 1;
    transform: none;
    filter: none;
    animation: sfContactPreviewIn 0.78s cubic-bezier(0.2, 1, 0.28, 1) 0.96s backwards;
  }

  .sf-counter.sf-in-view .sf-ai-prompt-card {
    opacity: 1;
    transform: none;
    filter: none;
    animation: sfContactPromptPop 0.68s cubic-bezier(0.16, 1.24, 0.32, 1) 1.26s backwards;
  }

  .sf-counter.sf-in-view .sf-ai-prompt-card::before {
    animation: sfContactSweep 1.05s ease 1.68s both;
  }

  .sf-counter.sf-in-view .sf-ai-send-icon {
    animation: sfContactSendPulse 1.8s ease 2s 2;
  }

  .sf-counter.sf-in-view.sf-replay-ready:not(.sf-replay-pulse) .sf-section-kicker,
  .sf-counter.sf-in-view.sf-replay-ready:not(.sf-replay-pulse) h2,
  .sf-counter.sf-in-view.sf-replay-ready:not(.sf-replay-pulse) .sf-section-copy span,
  .sf-counter.sf-in-view.sf-replay-ready:not(.sf-replay-pulse) .sf-ai-preview-card,
  .sf-counter.sf-in-view.sf-replay-ready:not(.sf-replay-pulse) .sf-ai-prompt-card,
  .sf-counter.sf-in-view.sf-replay-ready:not(.sf-replay-pulse) .sf-ai-send-icon {
    opacity: 1;
    transform: none;
    animation: none;
    filter: none;
  }

  .sf-counter.sf-in-view.sf-replay-ready:not(.sf-replay-pulse) .sf-ai-prompt-card::before {
    animation: none;
  }

  .sf-counter.sf-in-view.sf-replay-pulse .sf-section-kicker {
    animation: sfContactFadeLift 0.52s cubic-bezier(0.22, 1, 0.36, 1) 0.08s both;
  }

  .sf-counter.sf-in-view.sf-replay-pulse h2 {
    animation: sfContactTitleIn 0.82s cubic-bezier(0.18, 1, 0.32, 1) 0.18s both;
  }

  .sf-counter.sf-in-view.sf-replay-pulse .sf-section-copy span:first-child {
    animation: sfContactFadeLift 0.52s cubic-bezier(0.22, 1, 0.36, 1) 0.62s both;
  }

  .sf-counter.sf-in-view.sf-replay-pulse .sf-section-copy span:last-child {
    animation: sfContactFadeLift 0.52s cubic-bezier(0.22, 1, 0.36, 1) 0.76s both;
  }

  .sf-counter.sf-in-view.sf-replay-pulse .sf-ai-preview-card {
    animation: sfContactPreviewIn 0.78s cubic-bezier(0.2, 1, 0.28, 1) 0.96s both;
  }

  .sf-counter.sf-in-view.sf-replay-pulse .sf-ai-prompt-card {
    animation: sfContactPromptPop 0.68s cubic-bezier(0.16, 1.24, 0.32, 1) 1.26s both;
  }

  .sf-counter.sf-in-view.sf-replay-pulse .sf-ai-prompt-card::before {
    animation: sfContactSweep 1.05s ease 1.68s both;
  }

  .sf-counter.sf-in-view.sf-replay-pulse .sf-ai-send-icon {
    animation: sfContactSendPulse 1.8s ease 2s 2;
  }

  @keyframes sfContactFadeLift {
    from {
      opacity: 0;
      transform: translateY(14px);
      filter: blur(6px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
      filter: none;
    }
  }

  @keyframes sfContactTitleIn {
    from {
      opacity: 0;
      transform: translateY(22px);
      filter: blur(10px);
    }

    58% {
      opacity: 0.72;
      filter: blur(2px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
      filter: none;
    }
  }

  @keyframes sfContactPreviewIn {
    from {
      opacity: 0;
      transform: translateY(32px) scale(0.985);
      filter: blur(10px);
    }

    to {
      opacity: 1;
      transform: translateY(0) scale(1);
      filter: none;
    }
  }

  @keyframes sfContactPromptPop {
    from {
      opacity: 0;
      transform: translateY(34px) scale(0.94);
      filter: blur(12px);
    }

    72% {
      opacity: 1;
      transform: translateY(-4px) scale(1.012);
      filter: none;
    }

    to {
      opacity: 1;
      transform: translateY(0) scale(1);
      filter: none;
    }
  }

  @keyframes sfContactSweep {
    0% {
      opacity: 0;
      transform: translateX(-120%);
    }

    18% {
      opacity: 1;
    }

    100% {
      opacity: 0;
      transform: translateX(120%);
    }
  }

  @keyframes sfContactSendPulse {
    0%,
    100% {
      transform: translateY(0);
      box-shadow: none;
    }

    50% {
      transform: translateY(-2px);
      box-shadow: 0 0 18px rgba(247, 247, 241, 0.18);
    }
  }

  .sf-reveal {
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94), transform 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .sf-reveal.sf-in-view {
    opacity: 1;
    transform: translateY(0);
  }

