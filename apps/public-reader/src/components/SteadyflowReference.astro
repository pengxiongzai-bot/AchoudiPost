---
const solutionLinks = [
  {
    title: "设计师",
    description: "从想法到成稿，一步到位",
    href: "https://www.lovart.ai/zh/designers"
  },
  {
    title: "营销人员",
    description: "各渠道品牌素材，批量生成",
    href: "https://www.lovart.ai/zh/marketers"
  },
  {
    title: "企业主",
    description: "产品图、广告，几分钟搞定",
    href: "https://www.lovart.ai/zh/business-owners"
  }
];

const toolStatuses = [
  "已分析用户意图",
  "已探索视觉趋势",
  "已收集参考资料"
];

const posters = [
  {
    label: "Poster 01",
    src: "/lovart/12-poster-01-5049909fb1.png"
  },
  {
    label: "Poster 02",
    src: "/lovart/13-poster-02-7938576715.png"
  },
  {
    label: "Poster 03",
    src: "/lovart/14-poster-03-d0a9be6861.png"
  },
  {
    label: "Poster 04",
    src: "/lovart/15-poster-04-6b1a28475b.png"
  }
];

const featurePanels = [
  {
    kicker: "点选编辑",
    title: "懂你所想，\n精准编辑",
    body: "精准定点修改，只改该改之处。Lovart 保持设计品质，让每一次编辑都恰到好处。",
    cta: "体验点选编辑",
    media: "point",
    align: "left"
  },
  {
    kicker: "风格一致性",
    title: "每一次创作，\n风格始终如一",
    body: "Lovart 洞察你的风格，在不同形式与项目中保持一致。无论迭代多少版，换过几种格式，辨识度始终在线。",
    cta: "探索风格一致性",
    media: "style",
    align: "right"
  },
  {
    kicker: "文字编辑",
    title: "自由编辑文字，\n灵活且可控",
    body: "文字，不必困于画面。Lovart 智能分层，让图中文字独立可编辑。画面完整，表达无拘。",
    cta: "体验文字编辑",
    media: "text",
    align: "left"
  },
  {
    kicker: "视觉洞察",
    title: "设计参考，\n贵在精准",
    body: "Lovart 理解参考图背后的结构、氛围与色彩关系，并将这些线索带入每一次生成。",
    cta: "探索视觉洞察",
    media: "reference",
    align: "right"
  }
];

const footerColumns = [
  {
    title: "公司",
    links: ["定价", "更新日志", "文档", "新闻", "使用条款", "隐私政策"]
  },
  {
    title: "资源",
    links: ["探索", "博客", "工具", "功能", "解决方案", "专题"]
  },
  {
    title: "社交媒体",
    links: ["X", "YouTube", "LinkedIn", "Instagram", "TikTok"]
  }
];
---

<main class="lovart-page" data-steadyflow-reference>
  <header class="site-header">
    <div class="nav-shell">
      <a class="brand-link" href="#top" aria-label="Lovart 首页">
        <span class="lovart-mark" aria-hidden="true"><span></span><span></span></span>
        <span>Lovart</span>
      </a>

      <nav class="desktop-nav" aria-label="主导航">
        <a href="#top">首页</a>
        <div class="solution-nav">
          <button type="button">
            解决方案
            <span aria-hidden="true">⌄</span>
          </button>
          <div class="solution-menu" aria-label="解决方案">
            {solutionLinks.map((item) => (
              <a href={item.href}>
                <strong>{item.title}</strong>
                <span>{item.description}</span>
              </a>
            ))}
          </div>
        </div>
        <a href="https://www.lovart.ai/zh/explore">探索</a>
        <a href="https://www.lovart.ai/zh/pricing">定价</a>
      </nav>

      <a class="nav-cta" href="https://www.lovart.ai/zh">开始体验</a>

      <details class="mobile-menu">
        <summary aria-label="Open menu">☰</summary>
        <div>
          <a href="#top">首页</a>
          <a href="#system">解决方案</a>
          <a href="https://www.lovart.ai/zh/explore">探索</a>
          <a href="https://www.lovart.ai/zh/pricing">定价</a>
        </div>
      </details>
    </div>
  </header>

  <section class="hero-section" id="top">
    <div class="hero-copy">
      <p class="eyebrow">你的 AI 设计助手</p>
      <h1>
        <span>为新生代运动品牌<sup>(1)</sup></span>
        <span>设计一个商品详情页</span>
      </h1>
      <a class="primary-button" href="https://www.lovart.ai/zh">立即设计</a>
    </div>

    <div class="hero-board">
      <div class="editor-surface">
        <div class="project-title">
          <span class="lovart-mark" aria-hidden="true"><span></span><span></span></span>
          <span>运动产品发布</span>
          <span aria-hidden="true">⌄</span>
        </div>

        <div class="asset-canvas" aria-label="运动产品发布画布">
          <img class="canvas-image shoe" src="/lovart/01-image-78b3accb63.png" alt="白色运动鞋" />
          <img class="canvas-image trainer" src="/lovart/02-image-c88bde8145.png" alt="运动员训练姿势" />
          <div class="canvas-video selected">
            <div class="media-label">
              <span>▣ Video</span>
              <span>800 x 1440</span>
            </div>
            <video
              src="/lovart/30-video-afae2ca049.mp4"
              poster="/lovart/31-poster-05b9d3d1b4.png"
              autoplay
              muted
              loop
              playsinline
            ></video>
          </div>
          <img class="canvas-image detail" src="/lovart/03-image-c4b5d18c0b.png" alt="运动鞋上脚细节" />
          <img class="canvas-image shoes" src="/lovart/04-image-d3769ba840.png" alt="白色鞋子俯视" />
        </div>

        <aside class="assistant-panel" aria-label="AI 设计助手对话">
          <span class="panel-title">新对话</span>
          <div class="user-bubble">
            为跑鞋产品页面设计视觉素材，包括主图、产品特写和突显性能与材质的运动员上脚照。
          </div>
          <div class="status-list">
            {toolStatuses.map((status) => (
              <div class="status-row">
                <span aria-hidden="true">◎</span>
                <span>{status}</span>
              </div>
            ))}
          </div>
          <p>我已为新一代跑鞋产品详情页生成了一套视觉素材，聚焦清晰度和性能感染力。</p>
          <p>
            这套素材包含充满速度感的主图、聚焦材质的特写以及可控的上脚照，通过统一的光线和透视角度支撑产品详情页的视觉流程。
          </p>
        </aside>
      </div>
    </div>
  </section>

  <section class="system-section" id="system">
    <div class="system-sticky">
      <div class="section-heading">
        <p class="eyebrow">自主智能</p>
        <h2>以系统思维设计</h2>
        <p>
          设计决策，并非一座孤岛。
          <br />
          Lovart 将色彩、版式、语言统一为完整的品牌体系，
          <br />
          从第一稿，到第一百稿。
        </p>
      </div>

      <div class="system-composition">
        <div class="eyewear-stage">
          <div class="media-label">
            <span>▣ Image</span>
            <span>720 x 960</span>
          </div>
          <img src="/lovart/11-eyewear-7f9784a644.png" alt="智能眼镜" />
          <div class="prompt-bar">
            <span aria-hidden="true">⌁</span>
            <p>为该眼镜品牌创建一套电商活动海报</p>
            <span aria-hidden="true">□</span>
            <button type="button" aria-label="提交提示词">↑</button>
          </div>
        </div>

        <div class="poster-row" aria-label="电商活动海报">
          {posters.map((poster) => (
            <figure>
              <div class="media-label">
                <span>▣ Image</span>
                <span>720 x 960</span>
              </div>
              <img src={poster.src} alt={poster.label} />
            </figure>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="feature-deck">
    <div class="feature-intro">
      <p class="eyebrow">功能特性</p>
      <h2>设计, 不止于生成</h2>
      <p>AI 只是起点，品味由你来主导。</p>
    </div>

    {featurePanels.map((panel) => (
      <section class:list={["feature-panel", panel.align]}>
        <div class="feature-sticky">
          {panel.align === "left" ? (
            <>
              <div class="feature-copy">
                <p class="feature-kicker">{panel.kicker}</p>
                <h3>{panel.title}</h3>
                <p>{panel.body}</p>
                <a class="primary-button small" href="https://www.lovart.ai/zh">{panel.cta}</a>
              </div>
              <div class:list={["feature-media", `${panel.media}-media`, panel.media === "point" ? "race-media" : null]}>
                {panel.media === "point" && (
                  <>
                    <div class="media-label">
                      <span>▣ Image</span>
                      <span>1440 x 800</span>
                    </div>
                    <div class="race-frame">
                      <img src="/lovart/16-touch-edit-daf2991dcd.png" alt="点选编辑原始图片" />
                      <img class="race-result" src="/lovart/17-touch-edit-result-5fb2e6c2fc.png" alt="点选编辑后的 Lovart 图片" />
                    </div>
                    <div class="prompt-bar">
                      <span aria-hidden="true">⌁</span>
                      <p>移除 <span>旗帜</span> 和 <span>汽车</span> 的图案，并换成 Lovart Logo</p>
                      <span aria-hidden="true">□</span>
                      <button type="button" aria-label="提交提示词">↑</button>
                    </div>
                  </>
                )}
                {panel.media === "text" && (
                  <>
                    <div class="media-label">
                      <span>▣ Image</span>
                      <span>960 x 720</span>
                    </div>
                    <img src="/lovart/25-text-edit-0e17f19145.png" alt="可编辑文字图形" />
                  </>
                )}
              </div>
            </>
          ) : (
            <>
              <div class:list={["feature-media", `${panel.media}-media`, panel.media === "reference" ? "reference-media" : null]}>
                {panel.media === "style" && (
                  <>
                    <div class="media-label">
                      <span>▣ Image</span>
                      <span>960 x 1080</span>
                    </div>
                    <img class="portrait" src="/lovart/22-portrait-result-ffd7023347.png" alt="品牌人像" />
                    <img class="floating-hat" src="/lovart/23-green-beanie-hat-da729a1d98.png" alt="绿色帽子" />
                    <img class="floating-book" src="/lovart/24-made-by-lovart-book-1c93df0363.png" alt="Made by Lovart 书封" />
                  </>
                )}
                {panel.media === "reference" && (
                  <>
                    <div class="reference-grid">
                      <img src="/lovart/26-modern-office-interior-a86d8dee9e.png" alt="现代办公空间" />
                      <img src="/lovart/27-office-space-7f9ca7bf5c.png" alt="室内设计参考" />
                      <img src="/lovart/28-interior-design-f0600fedd9.png" alt="室内材质参考" />
                      <img src="/lovart/29-modern-workspace-8210180585.png" alt="现代工作区" />
                    </div>
                    <div class="prompt-bar">
                      <span aria-hidden="true">⌁</span>
                      <p>为新工作室空间建立一组视觉参考，保持材质、光线和品牌调性一致。</p>
                      <span aria-hidden="true">□</span>
                      <button type="button" aria-label="提交提示词">↑</button>
                    </div>
                  </>
                )}
              </div>
              <div class="feature-copy">
                <p class="feature-kicker">{panel.kicker}</p>
                <h3>{panel.title}</h3>
                <p>{panel.body}</p>
                <a class="primary-button small" href="https://www.lovart.ai/zh">{panel.cta}</a>
              </div>
            </>
          )}
        </div>
      </section>
    ))}
  </section>

  <section class="cta-section">
    <div class="cta-card">
      <h2>用 Lovart 设计</h2>
      <p>全速创作，让愿景成真</p>
      <a class="primary-button" href="https://www.lovart.ai/zh">免费开始</a>
    </div>
  </section>

  <footer class="footer">
    <div class="footer-brand">
      <a class="brand-link" href="#top" aria-label="Lovart 首页">
        <span class="lovart-mark" aria-hidden="true"><span></span><span></span></span>
        <span>Lovart</span>
      </a>
      <span>© 2026 版权所有，Lovart</span>
    </div>
    <div class="footer-links">
      {footerColumns.map((column) => (
        <div>
          <h2>{column.title}</h2>
          {column.links.map((link) => (
            <a href="https://www.lovart.ai/zh">{link}</a>
          ))}
        </div>
      ))}
    </div>
  </footer>

  <div class="scroll-pill" aria-hidden="true"><span></span></div>
</main>

<style>
  .lovart-page {
    --bg: rgb(16, 15, 9);
    --bg-soft: rgb(23, 22, 18);
    --panel: rgb(25, 24, 21);
    --panel-2: rgb(32, 31, 29);
    --text: rgb(245, 244, 239);
    --muted: rgb(201, 200, 197);
    --dim: rgb(146, 146, 144);
    --line: rgba(245, 244, 239, 0.12);
    --line-strong: rgba(245, 244, 239, 0.18);
    --blue: rgb(20, 126, 255);
    --sans: "Noto Sans SC", ui-sans-serif, system-ui, sans-serif;
    --serif: "Noto Serif SC", ui-serif, Georgia, "Times New Roman", serif;
    min-height: 100vh;
    overflow: clip;
    background:
      radial-gradient(circle at 50% 0%, rgba(245, 244, 239, 0.04), transparent 32rem),
      var(--bg);
    color: var(--text);
    font-family: var(--sans);
    font-weight: 400;
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
  }

  .lovart-page *,
  .lovart-page *::before,
  .lovart-page *::after {
    box-sizing: border-box;
  }

  .lovart-page :where(a) {
    color: inherit;
    text-decoration: none;
  }

  .lovart-page :where(button, summary) {
    color: inherit;
    font: inherit;
  }

  .lovart-page :where(button, a, summary):focus-visible {
    outline: 2px solid var(--text);
    outline-offset: 4px;
  }

  .lovart-page img,
  .lovart-page video {
    display: block;
    max-width: 100%;
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    display: flex;
    justify-content: center;
    padding: 4px 20px 0;
    pointer-events: none;
  }

  .nav-shell {
    display: grid;
    width: min(960px, calc(100vw - 40px));
    height: 56px;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 32px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: rgba(16, 15, 9, 0.7);
    box-shadow: 0 18px 50px rgba(0, 0, 0, 0.18);
    backdrop-filter: blur(18px);
    pointer-events: auto;
  }

  .brand-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding-left: 16px;
    font-size: 21px;
    font-weight: 700;
    letter-spacing: -0.02em;
    white-space: nowrap;
  }

  .lovart-mark {
    position: relative;
    display: inline-grid;
    width: 22px;
    height: 22px;
    flex: 0 0 auto;
    place-items: center;
    border-radius: 999px;
    background: var(--text);
  }

  .lovart-mark::before {
    width: 8px;
    height: 8px;
    border: 2px solid var(--bg);
    border-radius: 999px;
    content: "";
  }

  .lovart-mark span:first-child,
  .lovart-mark span:last-child {
    position: absolute;
    width: 5px;
    height: 5px;
    border-radius: 999px;
    background: var(--bg);
    content: "";
  }

  .lovart-mark span:first-child {
    top: 5px;
    left: 4px;
  }

  .lovart-mark span:last-child {
    right: 4px;
    bottom: 5px;
  }

  .desktop-nav {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 54px;
    color: var(--text);
    font-size: 14px;
  }

  .desktop-nav a,
  .solution-nav button {
    opacity: 0.96;
    transition: opacity 180ms ease, color 180ms ease;
  }

  .desktop-nav a:hover,
  .solution-nav button:hover {
    opacity: 0.72;
  }

  .solution-nav {
    position: relative;
  }

  .solution-nav button {
    display: inline-flex;
    cursor: pointer;
    align-items: center;
    gap: 4px;
    border: 0;
    background: transparent;
  }

  .solution-menu {
    position: absolute;
    top: calc(100% + 18px);
    left: 50%;
    display: grid;
    width: 320px;
    gap: 4px;
    padding: 12px;
    border: 1px solid var(--line);
    border-radius: 20px;
    background: rgba(25, 24, 21, 0.94);
    box-shadow: 0 28px 70px rgba(0, 0, 0, 0.4);
    opacity: 0;
    pointer-events: none;
    transform: translate(-50%, -8px);
    transition: opacity 180ms ease, transform 180ms ease;
    backdrop-filter: blur(24px);
  }

  .solution-nav:hover .solution-menu,
  .solution-nav:focus-within .solution-menu {
    opacity: 1;
    pointer-events: auto;
    transform: translate(-50%, 0);
  }

  .solution-menu a {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 13px 14px;
    border-radius: 14px;
  }

  .solution-menu a:hover {
    background: rgba(245, 244, 239, 0.07);
    opacity: 1;
  }

  .solution-menu strong {
    font-size: 15px;
  }

  .solution-menu span {
    color: var(--dim);
    font-size: 13px;
  }

  .lovart-page .nav-cta {
    justify-self: end;
    margin-right: 8px;
    padding: 10px 18px 11px;
    border-radius: 999px;
    background: var(--text);
    color: var(--bg);
    font-size: 14px;
    font-weight: 600;
    transition: transform 180ms ease, background 180ms ease;
    white-space: nowrap;
  }

  .lovart-page .nav-cta:hover,
  .lovart-page .primary-button:hover {
    transform: translateY(-1px);
    background: #fff;
  }

  .mobile-menu {
    display: none;
  }

  .hero-section {
    position: relative;
    min-height: 991px;
    padding: 32px 20px 96px;
  }

  .hero-copy {
    display: grid;
    justify-items: center;
    gap: 24px;
    padding-top: 24px;
    text-align: center;
  }

  .eyebrow,
  .feature-kicker {
    margin: 0;
    color: var(--dim);
    font-size: 16px;
    letter-spacing: 0.02em;
  }

  .hero-copy h1,
  .section-heading h2,
  .feature-intro h2,
  .cta-card h2 {
    margin: 0;
    color: var(--text);
    font-family: var(--serif);
    font-weight: 400;
    letter-spacing: 0;
  }

  .hero-copy h1 {
    display: grid;
    gap: 8px;
    font-size: 48px;
    line-height: 1.1;
  }

  .hero-copy h1 span {
    position: relative;
    display: inline-block;
  }

  .hero-copy h1 span::after {
    position: absolute;
    right: 0;
    bottom: 4px;
    left: 0;
    height: 1px;
    background: rgba(245, 244, 239, 0.8);
    content: "";
  }

  .hero-copy sup {
    margin-left: 6px;
    font-family: var(--sans);
    font-size: 16px;
    font-weight: 600;
    vertical-align: super;
  }

  .lovart-page .primary-button {
    display: inline-flex;
    min-height: 52px;
    align-items: center;
    justify-content: center;
    padding: 0 28px;
    border-radius: 999px;
    background: var(--text);
    color: var(--bg);
    font-size: 15px;
    font-weight: 700;
    transition: transform 180ms ease, background 180ms ease;
  }

  .lovart-page .primary-button.small {
    min-height: 44px;
    padding: 0 20px;
    font-size: 14px;
  }

  .hero-board {
    width: min(1080px, calc(100vw - 40px));
    margin: 56px auto 0;
    padding: 48px;
    border-radius: 14px;
    background:
      radial-gradient(circle at 6% 72%, rgba(146, 118, 153, 0.32), transparent 19rem),
      radial-gradient(circle at 95% 54%, rgba(187, 168, 178, 0.24), transparent 15rem),
      linear-gradient(160deg, #f5f2ec 0%, #f2efea 43%, #eee8ef 100%);
  }

  .editor-surface {
    position: relative;
    display: grid;
    min-height: 560px;
    grid-template-columns: 1fr 304px;
    overflow: hidden;
    border-radius: 10px;
    background: rgb(25, 24, 21);
    box-shadow: 0 22px 80px rgba(0, 0, 0, 0.22);
  }

  .project-title {
    position: absolute;
    top: 18px;
    left: 18px;
    z-index: 3;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--text);
    font-size: 13px;
  }

  .project-title .lovart-mark {
    width: 17px;
    height: 17px;
  }

  .project-title .lovart-mark::before {
    width: 6px;
    height: 6px;
    border-width: 1px;
  }

  .asset-canvas {
    position: relative;
    min-height: 560px;
  }

  .canvas-image,
  .canvas-video {
