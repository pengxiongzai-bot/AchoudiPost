---
const toolStatuses = [
  "已拆解电商场景",
  "已整理 Skill 框架",
  "已规划私域承接"
];

const posters = [
  {
    label: "商品主图 Skill 海报",
    src: "/lovart/12-poster-01-5049909fb1.png"
  },
  {
    label: "短视频脚本 Skill 海报",
    src: "/lovart/13-poster-02-7938576715.png"
  },
  {
    label: "内容种草 Skill 海报",
    src: "/lovart/14-poster-03-d0a9be6861.png"
  },
  {
    label: "私域成交 Skill 海报",
    src: "/lovart/15-poster-04-6b1a28475b.png"
  }
];

const featurePanels = [
  {
    kicker: "商品视觉",
    title: "先把商品图，\n做成可复用框架",
    body: "主图、场景图、卖点图不再每次从零开始。这里会沉淀可直接复用的提示词结构、参考图逻辑和成片判断。",
    cta: "进入 AI 实战库",
    href: "/market/",
    mediaClass: "lv-race-media"
  },
  {
    kicker: "短视频素材",
    title: "从脚本到镜头，\n把起量动作拆清楚",
    body: "围绕短视频开头、产品展示、转场和口播，把能落地的生成流程整理成模块，后续可以持续补案例。",
    cta: "看最新文章",
    href: "/articles/",
    mediaClass: "lv-style-media"
  },
  {
    kicker: "内容资产",
    title: "文字不是装饰，\n而是成交入口",
    body: "标题、详情页、朋友圈、私信话术，都需要有结构。这里先用可控模板承接，后面再逐步把内容做厚。",
    cta: "查看资源工具",
    href: "/tools/",
    mediaClass: "lv-text-media"
  }
];
---

<section class="lv-home" data-steadyflow-reference aria-label="AchoudiPost Lovart visual base">
  <section class="lv-hero lv-screen" id="top">
    <div class="lv-hero-copy">
      <p class="lv-eyebrow">你的电商 AI 实战助手</p>
      <h1 aria-label="把电商 AI 实战方法整理成可复用的 Skill">
        <span>把电商 AI 实战方法</span>
        <span>整理成可复用的 Skill</span>
      </h1>
      <a class="lv-primary-button" href="/market/" data-portal-route>立即进入</a>
    </div>

    <div class="lv-hero-board" aria-label="AI 实战库画布">
      <div class="lv-editor-surface">
        <div class="lv-project-title">
          <span class="lv-brand-dot" aria-hidden="true">A</span>
          <span>AI 实战库</span>
          <span aria-hidden="true">⌄</span>
        </div>

        <div class="lv-asset-canvas">
          <img class="lv-canvas-image lv-shoe" src="/lovart/01-image-78b3accb63.png" alt="商品主图参考" />
          <img class="lv-canvas-image lv-trainer" src="/lovart/02-image-c88bde8145.png" alt="短视频人物参考" />
          <div class="lv-canvas-video lv-selected">
            <div class="lv-media-label">
              <span>▣ Video</span>
              <span>800 × 1440</span>
            </div>
            <video
              src="/lovart/30-video-afae2ca049.mp4"
              poster="/lovart/31-poster-05b9d3d1b4.png"
              autoplay
              muted
              loop
              playsinline
              aria-label="AI 视频素材参考"
            ></video>
          </div>
          <img class="lv-canvas-image lv-detail" src="/lovart/03-image-c4b5d18c0b.png" alt="商品细节参考" />
          <img class="lv-canvas-image lv-shoes" src="/lovart/04-image-d3769ba840.png" alt="商品组合参考" />
        </div>

        <aside class="lv-assistant-panel" aria-label="AI 助手整理结果">
          <span class="lv-panel-title">新整理</span>
          <div class="lv-user-bubble">
            帮我把商品主图、短视频脚本和私域成交路径，整理成一套可以反复使用的电商 AI Skill。
          </div>
          <div class="lv-status-list">
            {toolStatuses.map((status) => (
              <div class="lv-status-row">
                <span aria-hidden="true">✓</span>
                <span>{status}</span>
              </div>
            ))}
          </div>
          <p>
            已生成一套实战入口：从商品视觉开始，到内容表达、短视频素材、私域承接，逐步沉淀成可复用模块。
          </p>
          <p>
            后续每个模块都可以单独点开，继续补充教程、案例、素材和交付说明。
          </p>
        </aside>
      </div>
    </div>
  </section>

  <section class="lv-system lv-screen" id="system">
    <div class="lv-section-heading">
      <p class="lv-eyebrow">MODULE SYSTEM</p>
      <h2>从一个场景，到一套可复制 Skill</h2>
      <p>
        不是堆提示词，而是把电商 AI 生图、生视频、商品内容和私域成交拆成稳定路径。
      </p>
    </div>

    <div class="lv-system-composition">
      <div class="lv-eyewear-stage">
        <div class="lv-media-label">
          <span>▣ Image</span>
          <span>720 × 960</span>
        </div>
        <img src="/lovart/11-eyewear-7f9784a644.png" alt="商品视觉模块参考" />
        <div class="lv-prompt-bar">
          <span aria-hidden="true">⌁</span>
          <p>把这个商品场景整理成主图、卖点图和短视频开头的 Skill 模板</p>
          <a href="/market/" data-portal-route aria-label="进入 AI 实战库">↑</a>
        </div>
      </div>

      <div class="lv-poster-row" aria-label="模块海报">
        {posters.map((poster) => (
          <figure>
            <div class="lv-media-label">
              <span>▣ Image</span>
              <span>720 × 960</span>
            </div>
            <img src={poster.src} alt={poster.label} loading="lazy" />
          </figure>
        ))}
      </div>
    </div>
  </section>

  <section class="lv-feature-deck" id="features">
    <div class="lv-feature-intro">
      <p class="lv-eyebrow">CONTENT FLOW</p>
      <h2>内容不止展示，要能带人往下走</h2>
      <p>先保留三个大方向，后面我们再逐个页面补细节和真实功能。</p>
    </div>

    {featurePanels.map((panel, index) => (
      <section class:list={["lv-feature-panel", index % 2 === 1 ? "right" : "left"]}>
        <div class="lv-feature-sticky">
          {index % 2 === 1 ? (
            <>
              <div class:list={["lv-feature-media", panel.mediaClass]}>
                {panel.mediaClass === "lv-style-media" ? (
                  <>
                    <div class="lv-media-label">
                      <span>▣ Image</span>
                      <span>960 × 1080</span>
                    </div>
                    <img class="lv-portrait" src="/lovart/22-portrait-result-ffd7023347.png" alt="短视频风格参考" />
                    <img class="lv-floating-hat" src="/lovart/23-green-beanie-hat-da729a1d98.png" alt="视觉素材参考" />
                    <img class="lv-floating-book" src="/lovart/24-made-by-lovart-book-1c93df0363.png" alt="内容资产参考" />
                  </>
                ) : null}
              </div>
              <div class="lv-feature-copy">
                <p class="lv-feature-kicker">{panel.kicker}</p>
                <h3>{panel.title}</h3>
                <p>{panel.body}</p>
                <a class="lv-primary-button small" href={panel.href} data-portal-route>{panel.cta}</a>
              </div>
            </>
          ) : (
            <>
              <div class="lv-feature-copy">
                <p class="lv-feature-kicker">{panel.kicker}</p>
                <h3>{panel.title}</h3>
                <p>{panel.body}</p>
                <a class="lv-primary-button small" href={panel.href} data-portal-route>{panel.cta}</a>
              </div>
              <div class:list={["lv-feature-media", panel.mediaClass]}>
                {panel.mediaClass === "lv-race-media" ? (
                  <>
                    <div class="lv-media-label">
                      <span>▣ Image</span>
                      <span>1440 × 800</span>
                    </div>
                    <div class="lv-race-frame">
                      <img src="/lovart/16-touch-edit-daf2991dcd.png" alt="商品视觉原始参考" />
                      <img class="lv-race-result" src="/lovart/17-touch-edit-result-5fb2e6c2fc.png" alt="商品视觉编辑结果" />
                    </div>
                    <div class="lv-prompt-bar compact">
                      <span aria-hidden="true">⌁</span>
                      <p>只保留能提升点击和转化的视觉动作</p>
                      <a href="/market/" data-portal-route aria-label="进入 AI 实战库">↑</a>
                    </div>
                  </>
                ) : (
                  <>
                    <div class="lv-media-label">
                      <span>▣ Text</span>
                      <span>960 × 720</span>
                    </div>
                    <img src="/lovart/25-text-edit-0e17f19145.png" alt="文字内容编辑参考" />
                  </>
                )}
              </div>
            </>
          )}
        </div>
      </section>
    ))}
  </section>

  <section class="lv-cta-section">
    <div class="lv-cta-card">
      <p class="lv-eyebrow">ACHOUDIPOST</p>
      <h2>先进入实战库，再慢慢把每个模块做厚</h2>
      <p>这版先换成 Lovart 视觉底座；下一步我们可以开始逐屏删减、换图、补真实功能。</p>
      <a class="lv-primary-button" href="/market/" data-portal-route>进入 AI 实战库</a>
    </div>
  </section>

  <footer class="lv-footer">
    <div>
      <a class="lv-footer-brand" href="/" data-portal-route>
        <span class="lv-brand-dot" aria-hidden="true">A</span>
        <span>
          <strong>AchoudiPost</strong>
          <small>阿臭弟的小站</small>
        </span>
      </a>
      <p>整理电商 AI 赋能框架、实战课程和长期更新的飞书知识库。</p>
    </div>
    <nav aria-label="页脚导航">
      <a href="/market/" data-portal-route>AI实战库</a>
      <a href="/articles/" data-portal-route>文章</a>
      <a href="/tools/" data-portal-route>资源工具</a>
      <a href="/about/" data-portal-route>关于</a>
    </nav>
  </footer>
</section>

<style>
  .lv-home {
    --lv-bg: rgb(16, 15, 9);
    --lv-bg-soft: rgb(23, 22, 18);
    --lv-panel: rgb(25, 24, 21);
    --lv-panel-2: rgb(32, 31, 29);
    --lv-text: rgb(245, 244, 239);
    --lv-muted: rgb(201, 200, 197);
    --lv-dim: rgb(146, 146, 144);
    --lv-line: rgba(245, 244, 239, 0.12);
    --lv-line-strong: rgba(245, 244, 239, 0.2);
    --lv-blue: rgb(20, 126, 255);
    --lv-serif: "Noto Serif SC", "Songti SC", "STSong", "Times New Roman", serif;
    --lv-sans: "Noto Sans SC", "PingFang SC", "Microsoft YaHei", ui-sans-serif, system-ui, sans-serif;
    min-height: 100vh;
    overflow: clip;
    background:
      radial-gradient(circle at 50% 0%, rgba(245, 244, 239, 0.04), transparent 34rem),
      var(--lv-bg);
    color: var(--lv-text);
    font-family: var(--lv-sans);
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
  }

  .lv-home *,
  .lv-home *::before,
  .lv-home *::after {
    box-sizing: border-box;
  }

  .lv-home img,
  .lv-home video {
    display: block;
    max-width: 100%;
  }

  .lv-screen {
    min-height: 100svh;
  }

  .lv-hero {
    position: relative;
    min-height: 1060px;
    padding: 128px 20px 104px;
  }

  .lv-hero-copy {
    display: grid;
    justify-items: center;
    gap: 26px;
    text-align: center;
  }

  .lv-eyebrow,
  .lv-feature-kicker {
    margin: 0;
    color: var(--lv-dim);
    font-size: 16px;
    font-weight: 500;
    letter-spacing: 0.02em;
  }

  .lv-hero-copy h1,
  .lv-section-heading h2,
  .lv-feature-intro h2,
  .lv-cta-card h2 {
    margin: 0;
    color: var(--lv-text);
    font-family: var(--lv-serif);
    font-weight: 400;
    letter-spacing: 0;
  }

  .lv-hero-copy h1 {
    display: grid;
    gap: 10px;
    font-size: clamp(46px, 5.4vw, 92px);
    line-height: 1.08;
  }

  .lv-hero-copy h1 span {
    position: relative;
    display: inline-block;
    padding-inline: 0.03em;
    background: linear-gradient(
      90deg,
      rgba(245, 244, 239, 0.34),
      var(--lv-text) 36%,
      var(--lv-text) 68%,
      rgba(245, 244, 239, 0.52)
    );
    background-size: 220% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    animation: lv-title-glide 4.8s ease-in-out infinite alternate;
  }

  .lv-hero-copy h1 span::after {
    content: "";
    position: absolute;
    right: 0;
    bottom: 0.08em;
    left: 0;
    height: 1px;
    background: rgba(245, 244, 239, 0.78);
    transform-origin: left center;
    animation: lv-line-in 1.1s cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  .lv-hero-copy h1 span:nth-child(2) {
    animation-delay: 0.45s;
  }

  .lv-hero-copy h1 span:nth-child(2)::after {
    animation-delay: 0.18s;
  }

  .lv-primary-button {
    display: inline-flex;
    min-height: 54px;
    align-items: center;
    justify-content: center;
    padding: 0 30px;
    border: 0;
    border-radius: 999px;
    background: var(--lv-text);
    color: var(--lv-bg);
    font-size: 15px;
    font-weight: 800;
    transition: transform 180ms ease, background 180ms ease, opacity 180ms ease;
  }

  .lv-primary-button:hover {
    transform: translateY(-1px);
    background: #fff;
  }

  .lv-primary-button.small {
    min-height: 44px;
    padding: 0 20px;
    font-size: 14px;
  }

  .lv-hero-board {
    width: min(1080px, calc(100vw - 40px));
    margin: 58px auto 0;
    padding: 48px;
    border-radius: 14px;
    background:
      radial-gradient(circle at 6% 72%, rgba(146, 118, 153, 0.32), transparent 19rem),
      radial-gradient(circle at 95% 54%, rgba(187, 168, 178, 0.24), transparent 15rem),
      linear-gradient(160deg, #f5f2ec 0%, #f2efea 43%, #eee8ef 100%);
    box-shadow: 0 28px 80px rgba(0, 0, 0, 0.22);
  }

  .lv-editor-surface {
    position: relative;
    display: grid;
    min-height: 560px;
    grid-template-columns: 1fr 304px;
    overflow: hidden;
    border-radius: 10px;
    background: var(--lv-panel);
    box-shadow: 0 22px 80px rgba(0, 0, 0, 0.22);
  }

  .lv-project-title {
    position: absolute;
    top: 18px;
    left: 18px;
    z-index: 3;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--lv-text);
    font-size: 13px;
  }

  .lv-brand-dot {
    position: relative;
    display: inline-grid;
    width: 22px;
    height: 22px;
    place-items: center;
    border-radius: 999px;
    background: var(--lv-text);
    color: var(--lv-bg);
    font-size: 12px;
    font-weight: 900;
    line-height: 1;
  }

  .lv-brand-dot::after {
    content: "";
    position: absolute;
    right: -1px;
    bottom: -1px;
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: #c3ff44;
  }

  .lv-asset-canvas {
    position: relative;
    min-height: 560px;
  }

  .lv-canvas-image,
  .lv-canvas-video {
    position: absolute;
  }

  .lv-canvas-image {
    object-fit: cover;
  }

  .lv-shoe {
    top: 116px;
    left: 44px;
    width: 160px;
    height: 160px;
  }

  .lv-trainer {
    top: 352px;
    left: 44px;
    width: 178px;
    height: 178px;
  }

  .lv-selected {
    top: 86px;
    left: 284px;
    width: 215px;
    padding-top: 26px;
    outline: 2px solid var(--lv-blue);
    outline-offset: 0;
  }

  .lv-selected::before,
  .lv-selected::after {
    content: "";
    position: absolute;
    width: 7px;
    height: 7px;
    border: 1px solid var(--lv-blue);
    background: #d7e9ff;
  }

  .lv-selected::before {
    top: 23px;
    left: -4px;
  }

  .lv-selected::after {
    right: -4px;
    bottom: -4px;
  }

  .lv-selected video {
    width: 100%;
    aspect-ratio: 800 / 1440;
    object-fit: cover;
  }

  .lv-detail {
    top: 126px;
    left: 530px;
    width: 140px;
    height: 184px;
    filter: brightness(0.76);
  }

  .lv-shoes {
    right: 232px;
    bottom: -30px;
    width: 128px;
    height: 128px;
    object-fit: contain;
  }

  .lv-assistant-panel {
    display: flex;
    min-height: 560px;
    flex-direction: column;
    gap: 18px;
    padding: 22px 18px;
    border-left: 1px solid rgba(245, 244, 239, 0.06);
    background: rgba(32, 31, 29, 0.92);
    color: var(--lv-dim);
    font-size: 13px;
    line-height: 1.7;
  }

  .lv-panel-title {
    color: rgba(245, 244, 239, 0.35);
  }

  .lv-user-bubble {
    margin-top: 16px;
    padding: 14px 16px;
    border-radius: 14px;
    background: rgba(245, 244, 239, 0.06);
    color: var(--lv-muted);
  }

  .lv-status-list {
    display: grid;
    gap: 11px;
    margin-top: 8px;
  }

  .lv-status-row {
    display: flex;
    align-items: center;
    gap: 9px;
    color: var(--lv-muted);
  }

  .lv-status-row span:first-child {
    color: var(--lv-text);
  }

  .lv-assistant-panel p {
    margin: 0;
  }

  .lv-media-label {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 8px;
    color: var(--lv-dim);
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 12px;
  }

  .lv-media-label span:first-child {
    color: var(--lv-text);
    font-family: var(--lv-sans);
  }

  .lv-system {
    display: grid;
    align-content: center;
    gap: 72px;
    padding: 120px 20px;
    background: var(--lv-bg-soft);
  }

  .lv-section-heading,
  .lv-feature-intro {
    display: grid;
    justify-items: center;
    gap: 22px;
    text-align: center;
  }

  .lv-section-heading h2,
  .lv-feature-intro h2,
  .lv-cta-card h2 {
    font-size: clamp(40px, 4.6vw, 64px);
    line-height: 1.22;
  }

  .lv-section-heading > p:last-child,
  .lv-feature-intro > p:last-child {
    max-width: 620px;
    margin: 0;
    color: var(--lv-muted);
    font-size: 18px;
    line-height: 1.6;
  }

  .lv-system-composition {
    display: grid;
    justify-items: center;
    gap: 64px;
  }

  .lv-eyewear-stage {
    position: relative;
    width: min(480px, calc(100vw - 40px));
  }

  .lv-eyewear-stage img {
    width: 272px;
    aspect-ratio: 720 / 960;
    margin: 0 auto;
    border: 2px solid var(--lv-blue);
    object-fit: cover;
  }

  .lv-prompt-bar {
    position: relative;
    z-index: 2;
    display: grid;
    min-height: 84px;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 14px;
    padding: 16px;
    border: 1px solid var(--lv-line-strong);
    border-radius: 16px;
    background: rgba(25, 24, 21, 0.9);
    box-shadow: 0 18px 55px rgba(0, 0, 0, 0.24);
    color: var(--lv-muted);
    backdrop-filter: blur(20px);
  }

  .lv-eyewear-stage .lv-prompt-bar {
    width: min(480px, calc(100vw - 40px));
    margin: -30px auto 0;
  }

  .lv-prompt-bar.compact {
    width: min(520px, calc(100% - 60px));
    margin: -58px auto 0;
  }

  .lv-prompt-bar p {
    margin: 0;
    color: var(--lv-text);
    font-size: 16px;
    line-height: 1.45;
  }

  .lv-prompt-bar > span,
  .lv-prompt-bar a {
    display: grid;
    width: 38px;
    height: 38px;
    place-items: center;
    border-radius: 999px;
    background: rgba(245, 244, 239, 0.12);
    color: var(--lv-text);
  }

  .lv-prompt-bar a {
    background: var(--lv-text);
    color: var(--lv-bg);
    font-size: 18px;
    font-weight: 900;
  }

  .lv-poster-row {
    display: grid;
    width: min(1080px, calc(100vw - 40px));
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
  }

  .lv-poster-row figure {
    margin: 0;
  }

  .lv-poster-row img {
    width: 100%;
    aspect-ratio: 720 / 960;
    object-fit: cover;
  }

  .lv-feature-deck {
    position: relative;
    padding: 120px 20px 80px;
    background: var(--lv-bg);
  }

  .lv-feature-intro {
    margin-bottom: 120px;
