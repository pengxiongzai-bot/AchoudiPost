---
const counterVideo =
  "https://d8j0ntlcm91z4.cloudfront.net/user_38xzZboKViGWJOttwIXH07lWA1P/hf_20260625_213350_6343fcfb-2892-4dcc-8573-1161447cacf5.mp4";

const moduleCards = [
  {
    name: "AI 生图 Skill",
    job: "商品视觉",
    stat: "6 个场景",
    description: "主图、场景图、卖点图，先把商品视觉做成可复用框架。",
    href: "/market/",
    image:
      "https://images.higgs.ai/?default=1&output=webp&url=https%3A%2F%2Fd8j0ntlcm91z4.cloudfront.net%2Fuser_38xzZboKViGWJOttwIXH07lWA1P%2Fhf_20260625_213624_40d877b4-92a9-44d3-be3c-5d3332db4402.png&w=1280&q=85"
  },
  {
    name: "AI 生视频 Skill",
    job: "短视频素材",
    stat: "起量入口",
    description: "从脚本、镜头到转场，围绕电商短视频先解决素材效率。",
    href: "/market/",
    image:
      "https://images.higgs.ai/?default=1&output=webp&url=https%3A%2F%2Fd8j0ntlcm91z4.cloudfront.net%2Fuser_38xzZboKViGWJOttwIXH07lWA1P%2Fhf_20260625_213908_9574cadd-4c04-4380-af84-a753e484415a.png&w=1280&q=85"
  },
  {
    name: "商品内容框架",
    job: "文案卖点",
    stat: "40+ 模板",
    description: "标题、详情页、直播话术，把卖点讲清楚再去放大流量。",
    href: "/articles/",
    image:
      "https://images.higgs.ai/?default=1&output=webp&url=https%3A%2F%2Fd8j0ntlcm91z4.cloudfront.net%2Fuser_38xzZboKViGWJOttwIXH07lWA1P%2Fhf_20260625_213950_c1686b87-f412-4878-b7fe-96ba5085ba01.png&w=1280&q=85"
  },
  {
    name: "私域成交路径",
    job: "微信承接",
    stat: "3 步转化",
    description: "从公开内容到加微交付，让用户知道下一步该点哪里。",
    href: "/about/",
    image:
      "https://images.higgs.ai/?default=1&output=webp&url=https%3A%2F%2Fd8j0ntlcm91z4.cloudfront.net%2Fuser_38xzZboKViGWJOttwIXH07lWA1P%2Fhf_20260625_214012_f14ffda8-1f1c-48bc-893f-1ad05f6bc2d9.png&w=1280&q=85"
  },
  {
    name: "电商工具流",
    job: "资源工具",
    stat: "常用清单",
    description: "图片、视频、运营和内容工具，按任务快速找到对应入口。",
    href: "/tools/",
    image:
      "https://images.higgs.ai/?default=1&output=webp&url=https%3A%2F%2Fd8j0ntlcm91z4.cloudfront.net%2Fuser_38xzZboKViGWJOttwIXH07lWA1P%2Fhf_20260625_214103_cadf49e5-cae8-42e2-9bec-955b7347f850.png&w=1280&q=85"
  },
  {
    name: "飞书知识库",
    job: "长期更新",
    stat: "持续沉淀",
    description: "课程、案例、素材和说明统一放进知识库，方便反复回来用。",
    href: "/guide/",
    image:
      "https://images.higgs.ai/?default=1&output=webp&url=https%3A%2F%2Fd8j0ntlcm91z4.cloudfront.net%2Fuser_38xzZboKViGWJOttwIXH07lWA1P%2Fhf_20260625_214142_c7344da9-f597-42b7-8c31-7ca5228503fb.png&w=1280&q=85"
  }
];

const featuredModuleCards = moduleCards.slice(0, 4);
const bespokeMarqueeImages = [
  "https://images.higgs.ai/?default=1&output=webp&url=https%3A%2F%2Fd8j0ntlcm91z4.cloudfront.net%2Fuser_38xzZboKViGWJOttwIXH07lWA1P%2Fhf_20260725_120544_94be5de4-0f4f-494c-bb78-c532290040a6.png&w=1920&q=85",
  "https://images.higgs.ai/?default=1&output=webp&url=https%3A%2F%2Fd8j0ntlcm91z4.cloudfront.net%2Fuser_38xzZboKViGWJOttwIXH07lWA1P%2Fhf_20260725_120601_5c6e4705-b992-4227-9dff-9b000351c283.png&w=1920&q=85",
  "https://images.higgs.ai/?default=1&output=webp&url=https%3A%2F%2Fd8j0ntlcm91z4.cloudfront.net%2Fuser_38xzZboKViGWJOttwIXH07lWA1P%2Fhf_20260725_120619_7bc65416-a3d7-4e8c-9929-743f233378fe.png&w=1920&q=85",
  "https://images.higgs.ai/?default=1&output=webp&url=https%3A%2F%2Fd8j0ntlcm91z4.cloudfront.net%2Fuser_38xzZboKViGWJOttwIXH07lWA1P%2Fhf_20260725_120627_b40a97b0-c5fa-408c-a77e-dc8fa44f8584.png&w=1920&q=85",
  "https://images.higgs.ai/?default=1&output=webp&url=https%3A%2F%2Fd8j0ntlcm91z4.cloudfront.net%2Fuser_38xzZboKViGWJOttwIXH07lWA1P%2Fhf_20260725_120635_515cde41-2dc6-48ce-a236-088a5bc74ca8.png&w=1920&q=85",
  "https://images.higgs.ai/?default=1&output=webp&url=https%3A%2F%2Fd8j0ntlcm91z4.cloudfront.net%2Fuser_38xzZboKViGWJOttwIXH07lWA1P%2Fhf_20260725_120645_5a1170c6-145b-477b-abd2-f8620acccd8d.png&w=1920&q=85"
];
const heroMarqueeImages = [...bespokeMarqueeImages, ...bespokeMarqueeImages];

const impactStats = [
  { value: "生图框架", label: "商品主图、场景图、卖点图" },
  { value: "生视频框架", label: "短视频开头、镜头转场、产品展示" },
  { value: "成交流程", label: "内容种草、私域承接、交付路径" }
];

---

<section class="sf-reference" data-steadyflow-reference aria-label="AchoudiPost 首屏参考块">
  <div class="sf-frame">
    <section class="sf-hero" id="sf-hero">
      <div class="sf-hero-content">
        <div class="sf-copy-stack">
          <h2 class="sf-kinetic-title" aria-label="把电商 AI 实战方法，整理成可复用的 Skill">
            <span class="sf-kinetic-line" style="--line-delay: .12s">
              <span class="sf-title-static">把</span>
              <span class="sf-title-fragment">
                <span class="sf-title-rule" aria-hidden="true"></span>
                <span class="sf-title-text" data-text="电商 AI 实战方法">电商 AI 实战方法</span>
              </span>
            </span>
            <span class="sf-kinetic-line" style="--line-delay: .42s">
              <span class="sf-title-static">整理成</span>
              <span class="sf-title-fragment">
                <span class="sf-title-rule" aria-hidden="true"></span>
                <span class="sf-title-text" data-text="可复用的 Skill">可复用的 Skill</span>
              </span>
            </span>
          </h2>
        </div>
        <div class="sf-hero-ctas sf-rise" style="--delay: .4s">
          <a class="sf-primary-cta" href="/market/" data-portal-route>进入 AI 实战库</a>
        </div>
      </div>

      <div class="sf-hero-marquee sf-rise" style="--delay: .66s" aria-label="建筑参考图片轮播">
        <div class="sf-marquee-curve sf-marquee-curve-top" aria-hidden="true">
          <svg viewBox="0 0 1440 100" preserveAspectRatio="none">
            <path fill="currentColor" d="M0 0H1440V50C1440 50 1200 100 720 100C240 100 0 50 0 50V0Z"></path>
          </svg>
        </div>
        <div class="sf-marquee-curve sf-marquee-curve-bottom" aria-hidden="true">
          <svg viewBox="0 0 1440 100" preserveAspectRatio="none">
            <path fill="currentColor" d="M0 100H1440V50C1440 50 1200 0 720 0C240 0 0 50 0 50V100Z"></path>
          </svg>
        </div>
        <div class="sf-hero-marquee-track" data-sf-hero-marquee-track>
          {heroMarqueeImages.map((src, index) => (
            <div class="sf-hero-marquee-card" aria-hidden={index >= bespokeMarqueeImages.length ? "true" : undefined}>
              <img src={src} alt="" loading="lazy" draggable="false" />
            </div>
          ))}
        </div>
      </div>

    </section>

    <section class="sf-achievements" id="sf-achievements" aria-labelledby="sfModulesHeading">
      <div class="sf-achievements-header sf-reveal">
        <div class="sf-achievements-title">
          <p class="sf-section-kicker">自主智能</p>
          <h2 id="sfModulesHeading">以系统思维设计</h2>
          <p class="sf-section-copy">
            <span>设计决策，并非一座孤岛。</span>
            <span>把生图、生视频、商品内容和私域成交统一成模块，</span>
            <span>从第一眼，到每一次点击。</span>
          </p>
        </div>
      </div>

      <div class="sf-poster-grid sf-reveal">
        {featuredModuleCards.map((card, index) => (
          <a class="sf-poster-card" href={card.href} data-portal-route aria-label={`查看 ${card.name}`}>
            <div class="sf-poster-meta" aria-hidden="true">
              <span>▧ Image</span>
              <span>720 × 960</span>
            </div>
            <div class="sf-poster-frame">
              <img src={card.image} alt="" loading={index > 1 ? "lazy" : "eager"} />
              <div class="sf-poster-shade"></div>
              <div class="sf-poster-copy">
                <span>{card.job}</span>
                <strong>{card.name}</strong>
                <p>{card.description}</p>
                <em>查看详细内容</em>
              </div>
            </div>
          </a>
        ))}
      </div>
    </section>

    <section class="sf-counter sf-reveal" id="sf-counter" aria-labelledby="sfCounterHeading">
      <div class="sf-counter-copy">
        <div class="sf-counter-pill">Skill Library</div>
        <h2 id="sfCounterHeading">一个电商 AI 实战框架，会比一堆零散提示词更有用</h2>
        <strong class="sf-giant-number">3+</strong>
        <p>核心实战方向正在持续沉淀</p>
      </div>

      <div class="sf-counter-visual">
        <div class="sf-earth-stage">
          <div class="sf-counter-video-frame">
            <video src={counterVideo} autoplay muted loop playsinline aria-hidden="true"></video>
            <div class="sf-counter-fade"></div>
            <div class="sf-cloud-overlay" aria-hidden="true"></div>
          </div>
          <div class="sf-blur-slab"></div>
        </div>

        <div class="sf-impact-stats" aria-label="AchoudiPost 实战方向">
          {impactStats.map((stat) => (
            <div class="sf-impact-stat">
              <strong>{stat.value}</strong>
              <p>{stat.label}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

  </div>
</section>

<script is:inline type="module" src="/scripts/steadyflow-reference.js"></script>

<style>
  @import url("https://fonts.googleapis.com/css2?family=Google+Sans+Flex:wght@500&family=Noto+Serif+SC:wght@400;500&display=swap");

  @font-face {
    font-family: "Stack Sans Headline";
    src: url("https://framerusercontent.com/modules/VqG9xS8K2qN3B8RHWMKb/UQYzREmGJ3JWCi77B0rN/StackSans-Medium.woff2")
      format("woff2");
    font-weight: 500;
    font-style: normal;
    font-display: swap;
  }

  .sf-reference {
    --sf-page-bg: rgb(18, 19, 15);
    --sf-hero-bg: rgb(7, 8, 6);
    --sf-surface: rgb(22, 23, 19);
    --sf-surface-soft: rgb(28, 29, 25);
    --sf-ink: rgb(19, 21, 21);
    --sf-light: rgb(247, 247, 241);
    --sf-blue: #4382bc;
    --sf-logo: #5bb8f0;
    --sf-muted: rgba(247, 247, 241, 0.58);
    --sf-headline: "Stack Sans Headline", sans-serif;
    --sf-serif-display: "Noto Serif SC", "Songti SC", "STSong", "SimSun", ui-serif, Georgia, "Times New Roman", serif;
    --sf-ui: "Google Sans Flex", sans-serif;
    position: relative;
    overflow: hidden;
    background: var(--sf-page-bg);
    color: var(--sf-ink);
    font-family: var(--sf-ui);
    font-weight: 500;
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
  }

  .sf-reference *,
  .sf-reference *::before,
  .sf-reference *::after {
    box-sizing: border-box;
  }

  .sf-reference a {
    color: inherit;
    text-decoration: none;
  }

  .sf-reference button {
    color: inherit;
    font: inherit;
  }

  .sf-frame {
    position: relative;
    overflow: hidden;
    background: var(--sf-page-bg);
  }

  .sf-navbar-wrap {
    position: fixed;
    top: 0;
    right: 0;
    left: 0;
    z-index: 80;
    padding: 30px;
    pointer-events: none;
  }

  .sf-desktop-navbar {
    display: flex;
    width: 100%;
    max-width: 1260px;
    justify-content: space-between;
    gap: 0;
    margin: 0 auto;
    pointer-events: auto;
    transition: gap 0.45s cubic-bezier(0.44, 0, 0.56, 1), justify-content 0.45s cubic-bezier(0.44, 0, 0.56, 1);
  }

  .sf-nav-pill {
    display: flex;
    align-items: center;
    border-radius: 20px;
    background: #fff;
    box-shadow: 0 8px 20px rgba(5, 8, 12, 0.1);
    transition: box-shadow 0.25s ease, transform 0.25s ease;
  }

  .sf-scrolled .sf-nav-pill {
    box-shadow: 0 12px 34px rgba(5, 8, 12, 0.14);
  }

  .sf-brand-pill {
    min-width: 216px;
    gap: 12px;
    padding: 12px 18px 12px 12px;
    color: var(--sf-ink);
  }

  .sf-achoudi-mark {
    position: relative;
    width: 38px;
    height: 38px;
    display: grid;
    place-items: center;
    flex: 0 0 auto;
    border: 1px solid var(--sf-ink);
    border-radius: 50%;
    background: var(--sf-ink);
    color: #fff;
    font-family: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    font-size: 17px;
    font-weight: 900;
    letter-spacing: -0.04em;
  }

  .sf-achoudi-mark::after {
    content: "";
    position: absolute;
    right: -2px;
    bottom: -2px;
    width: 8px;
    height: 8px;
    border: 2px solid #fff;
    border-radius: 50%;
    background: #97c731;
  }

  .sf-compact-mark {
    width: 32px;
    height: 32px;
    font-size: 15px;
  }

  .sf-brand-copy {
    display: flex;
    min-width: 0;
    flex-direction: column;
    gap: 2px;
  }

  .sf-brand-copy strong {
    font-family: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    font-size: 17px;
    font-weight: 850;
    letter-spacing: -0.03em;
    line-height: 1;
  }

  .sf-brand-copy small {
    color: var(--sf-muted);
    font-size: 11px;
    line-height: 1.1;
  }

  .sf-nav-menu {
    height: 64px;
    gap: 32px;
    padding: 0 32px;
    font-size: 14px;
  }

  .sf-nav-menu .nav-link {
    height: 100%;
    display: inline-flex;
    align-items: center;
    padding: 0;
    color: color-mix(in srgb, var(--sf-ink) 72%, transparent);
    font-weight: 700;
    line-height: 1;
    white-space: nowrap;
    transition: color 0.2s ease, opacity 0.2s ease;
  }

  .sf-nav-menu .nav-link::after,
  .sf-mobile-menu-panel .nav-link::after {
    display: none;
  }

  .sf-nav-menu .nav-link:hover,
  .sf-nav-menu .nav-link.active {
    color: var(--sf-ink);
  }

  .sf-action-pill {
    min-width: 216px;
    justify-content: flex-end;
    gap: 12px;
    padding: 6px 6px 6px 16px;
  }

  .sf-service-pulse {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--sf-muted);
    font-family: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    font-size: 12px;
    font-weight: 750;
    white-space: nowrap;
  }

  .sf-service-pulse span {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #b8b8b8;
    box-shadow: 0 0 0 0 rgba(151, 199, 49, 0);
  }

  .sf-service-pulse[data-status="online"] span {
    background: #97c731;
    box-shadow: 0 0 0 6px rgba(151, 199, 49, 0.12);
  }

  .sf-service-pulse[data-status="offline"] span {
    background: #e17a71;
    box-shadow: 0 0 0 6px rgba(225, 122, 113, 0.12);
  }

  .sf-service-pulse b {
    font-weight: 750;
  }

  .sf-icon-button {
    display: grid;
    width: 52px;
    height: 52px;
    place-items: center;
    padding: 0;
    border: 0;
    border-radius: 14px;
    background: var(--sf-ink);
    color: #fff;
    transition: transform 0.45s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .sf-icon-button:hover,
  .sf-primary-cta:hover {
    transform: scale(0.95);
  }

  .sf-icon-button svg {
    width: 21px;
    height: 21px;
    stroke-width: 1.8;
  }

  .sf-mobile-navbar,
  .sf-mobile-menu-backdrop {
    display: none;
  }

  .sf-hero {
    position: relative;
    display: flex;
    width: 100%;
    min-height: 100svh;
    justify-content: center;
    overflow: hidden;
    background: var(--sf-hero-bg);
  }

  .sf-hero-content {
    position: relative;
    z-index: 1;
    display: flex;
    width: 100%;
    max-width: 980px;
    flex-direction: column;
    align-items: center;
    gap: 56px;
    padding: clamp(210px, 17vw, 250px) 30px 158px;
    color: #fff;
    text-align: center;
  }

  .sf-copy-stack {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
  }

  .sf-rise {
    opacity: 0;
    transform: translateY(20px);
    animation: sf-rise 0.6s var(--delay, 0s) cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }

  @keyframes sf-rise {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .sf-hero-subtitle,
  .sf-counter-copy > p,
  .sf-impact-stat p {
    margin: 0;
  }

  .sf-kinetic-title {
    display: flex;
    max-width: 1080px;
    flex-direction: column;
    align-items: center;
    gap: 2px;
    margin: 0;
    color: rgba(255, 255, 255, 0.98);
    font-family: var(--sf-serif-display);
    font-size: clamp(68px, 5.1vw, 96px);
    font-weight: 400;
    letter-spacing: -0.035em;
    line-height: 1.02;
    text-shadow: 0 18px 58px rgba(0, 0, 0, 0.18);
  }

  .sf-kinetic-line {
    position: relative;
    display: flex;
    align-items: baseline;
    justify-content: center;
    opacity: 0;
    transform: translateY(18px);
    white-space: nowrap;
    animation: sf-title-line-rise 0.72s var(--line-delay, 0s) cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }

  .sf-title-static {
    position: relative;
    z-index: 2;
  }

  .sf-title-fragment {
    position: relative;
    display: inline-block;
    margin-left: 0.08em;
    padding-inline: 0.01em;
  }

  .sf-title-rule {
    position: absolute;
    right: 0;
    bottom: 0.03em;
    left: 0;
    height: 1px;
    background: rgba(255, 255, 255, 0.66);
    box-shadow: 0 0 18px rgba(255, 255, 255, 0.28);
    transform: scaleX(0);
    transform-origin: left center;
    animation: sf-title-rule-in 1.05s calc(var(--line-delay, 0s) + 0.16s) cubic-bezier(0.65, 0, 0.35, 1) forwards;
  }

  .sf-title-text {
    position: relative;
    z-index: 2;
    display: inline-block;
    color: rgba(255, 255, 255, 0.28);
  }

  .sf-title-text::before,
  .sf-title-text::after {
    content: attr(data-text);
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .sf-title-text::before {
    z-index: 1;
    color: rgba(255, 255, 255, 0.98);
    clip-path: inset(0 100% 0 0);
    animation: sf-title-clip-in 1.16s calc(var(--line-delay, 0s) + 0.08s) cubic-bezier(0.65, 0, 0.35, 1) forwards;
  }

  .sf-title-text::after {
    z-index: 2;
    color: transparent;
    background: linear-gradient(100deg, transparent 0%, rgba(255, 255, 255, 0) 28%, rgba(255, 255, 255, 0.86) 50%, rgba(255, 255, 255, 0) 72%, transparent 100%);
    background-size: 210% 100%;
    background-position: 150% 0;
    -webkit-background-clip: text;
    background-clip: text;
    opacity: 0;
    animation: sf-title-shimmer 4.8s calc(var(--line-delay, 0s) + 1.35s) ease-in-out infinite;
  }

  @keyframes sf-title-line-rise {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes sf-title-clip-in {
    0% {
      clip-path: inset(0 100% 0 0);
    }

    55% {
      clip-path: inset(0 24% 0 0);
    }

    100% {
      clip-path: inset(0 0 0 0);
    }
  }

  @keyframes sf-title-rule-in {
    0% {
      opacity: 0;
      transform: scaleX(0);
    }

    22% {
      opacity: 1;
    }

    100% {
      opacity: 0.72;
