    z-index: 0;
    color: var(--sf-hero-bg);
    overflow: hidden;
    padding: 0;
    background: transparent;
    -webkit-mask-image: linear-gradient(90deg, transparent 0%, #000 3.5%, #000 96.5%, transparent 100%);
    mask-image: linear-gradient(90deg, transparent 0%, #000 3.5%, #000 96.5%, transparent 100%);
  }

  .sf-marquee-curve {
    position: absolute;
    right: 0;
    left: 0;
    z-index: 10;
    height: var(--sf-hero-curve-height);
    pointer-events: none;
  }

  .sf-marquee-curve svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  .sf-marquee-curve-top {
    top: 0;
  }

  .sf-marquee-curve-bottom {
    bottom: 0;
  }

  .sf-hero-marquee-track {
    display: flex;
    width: max-content;
    gap: 16px;
    padding: calc(var(--sf-hero-curve-height) * 0.7) 0;
    user-select: none;
    touch-action: manipulation;
    animation: sf-hero-marquee-scroll var(--sf-hero-marquee-duration) linear infinite;
    will-change: transform;
  }

  .sf-hero-marquee-track.sf-is-dragging {
    cursor: grabbing;
  }

  @keyframes sf-hero-marquee-scroll {
    from {
      transform: translate3d(0, 0, 0);
    }

    to {
      transform: translate3d(var(--sf-hero-marquee-loop-distance), 0, 0);
    }
  }

  .sf-hero-marquee-card {
    position: relative;
    display: block;
    width: var(--sf-hero-marquee-card-width);
    aspect-ratio: 3 / 4;
    flex: 0 0 auto;
    padding: 0;
    overflow: hidden;
    border: 0;
    border-radius: var(--sf-hero-marquee-radius);
    background: rgba(255, 255, 255, 0.02);
    cursor: zoom-in;
    appearance: none;
  }

  .sf-hero-marquee-card img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: contain;
    pointer-events: none;
    transition: filter 0.5s ease;
  }

  .sf-hero-marquee-card::after {
    content: "点击预览";
    position: absolute;
    right: 14px;
    bottom: 14px;
    z-index: 2;
    padding: 7px 12px;
    border: 1px solid rgba(255, 255, 255, 0.24);
    border-radius: 999px;
    background: rgba(7, 8, 6, 0.48);
    color: rgba(255, 255, 255, 0.92);
    font-size: 12px;
    font-weight: 750;
    line-height: 1;
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 0.25s ease, transform 0.25s ease;
    pointer-events: none;
    backdrop-filter: blur(10px);
  }

  .sf-hero-marquee-card:hover img {
    filter: brightness(1.06);
  }

  .sf-hero-marquee-card:hover::after,
  .sf-hero-marquee-card:focus-visible::after {
    opacity: 1;
    transform: translateY(0);
  }

  .sf-hero-marquee-card:focus-visible {
    outline: 2px solid rgba(247, 247, 241, 0.88);
    outline-offset: 4px;
  }

  .sf-hero-marquee-track.sf-is-dragging .sf-hero-marquee-card {
    cursor: grabbing;
  }

  @media (prefers-reduced-motion: reduce) {
