---
const moduleCards = [
  {
    name: "AI 电商视觉Skill",
    job: "商品视觉",
    stat: "视觉系统",
    description: "主图、场景图、卖点图，把商品视觉做成可复用的电商框架。",
    href: "/market/",
    image:
      "https://images.higgs.ai/?default=1&output=webp&url=https%3A%2F%2Fd8j0ntlcm91z4.cloudfront.net%2Fuser_38xzZboKViGWJOttwIXH07lWA1P%2Fhf_20260625_213624_40d877b4-92a9-44d3-be3c-5d3332db4402.png&w=1280&q=85"
  },
  {
    name: "AI 电商视频Skill",
    job: "短视频素材",
    stat: "脚本到镜头",
    description: "从脚本、镜头、转场到成片节奏，先解决电商视频素材效率。",
    href: "/market/",
    image:
      "https://images.higgs.ai/?default=1&output=webp&url=https%3A%2F%2Fd8j0ntlcm91z4.cloudfront.net%2Fuser_38xzZboKViGWJOttwIXH07lWA1P%2Fhf_20260625_213908_9574cadd-4c04-4380-af84-a753e484415a.png&w=1280&q=85"
  },
  {
    name: "AI 电商自动化",
    job: "流程提效",
    stat: "自动流程",
    description: "把选品、素材整理、发布和复盘串起来，减少重复手动操作。",
    href: "/tools/",
    image:
      "https://images.higgs.ai/?default=1&output=webp&url=https%3A%2F%2Fd8j0ntlcm91z4.cloudfront.net%2Fuser_38xzZboKViGWJOttwIXH07lWA1P%2Fhf_20260625_213950_c1686b87-f412-4878-b7fe-96ba5085ba01.png&w=1280&q=85"
  },
  {
    name: "AI 电商Skill定制",
    job: "定制搭建",
    stat: "按需定制",
    description: "按你的产品、团队和流程，定制一套可以直接落地的电商 Skill。",
    href: "/about/",
    image:
      "https://images.higgs.ai/?default=1&output=webp&url=https%3A%2F%2Fd8j0ntlcm91z4.cloudfront.net%2Fuser_38xzZboKViGWJOttwIXH07lWA1P%2Fhf_20260625_214012_f14ffda8-1f1c-48bc-893f-1ad05f6bc2d9.png&w=1280&q=85"
  },
  {
    name: "电商工具流",
    job: "资源工具",
    stat: "常用清单",
    description: "图片、视频、运营和内容工具，按任务快速找到对应入口。",
    href: "/tools/",
    image:
      "https://images.higgs.ai/?default=1&output=webp&url=https%3A%2F%2Fd8j0ntlcm91z4.cloudfront.net%2Fuser_38xzZboKViGWJOttwIXH07lWA1P%2Fhf_20260625_214103_cadf49e5-cae8-42e2-9bec-955b7347f850.png&w=1280&q=85"
  },
  {
    name: "飞书知识库",
    job: "长期更新",
    stat: "持续沉淀",
    description: "课程、案例、素材和说明统一放进知识库，方便反复回来用。",
    href: "/guide/",
    image:
      "https://images.higgs.ai/?default=1&output=webp&url=https%3A%2F%2Fd8j0ntlcm91z4.cloudfront.net%2Fuser_38xzZboKViGWJOttwIXH07lWA1P%2Fhf_20260625_214142_c7344da9-f597-42b7-8c31-7ca5228503fb.png&w=1280&q=85"
  }
];

const featuredModuleCards = moduleCards.slice(0, 4);
const bespokeMarqueeImages = [
  "/images/hero-showcase-snow-chain.jpg",
  "/images/hero-showcase-dining-chair.jpg",
  "/images/hero-showcase-plush-bear.jpg",
  "/images/hero-showcase-red-sneaker.jpg",
  "/images/hero-showcase-panda-camera.jpg",
  "/images/hero-showcase-steel-container.jpg"
];
const heroMarqueeImages = [...bespokeMarqueeImages, ...bespokeMarqueeImages];
const systemPreviewImage = "/images/11-eyewear-7f9784a644.png";
const wechatQrImage = "/images/wechat-qr-yunx0723.jpg";
const wechatQrDrawingImage = "/images/wechat-qr-yunx0723-zuotu.jpg";

---

<section class="sf-reference" data-steadyflow-reference aria-label="AchoudiPost 首屏参考块">
  <div class="sf-frame">
    <section class="sf-hero" id="sf-hero">
      <div class="sf-hero-content">
        <div class="sf-copy-stack">
          <h2 class="sf-kinetic-title" aria-label="把电商 AI 实战方法，整理成可复用的 Skill">
            <span class="sf-kinetic-line" style="--line-delay: .12s">
              <span class="sf-title-static">把</span>
              <span class="sf-title-fragment">
                <span class="sf-title-rule" aria-hidden="true"></span>
                <span class="sf-title-text" data-text="电商 AI 实战方法">电商 AI 实战方法</span>
              </span>
            </span>
            <span class="sf-kinetic-line" style="--line-delay: .42s">
              <span class="sf-title-static">整理成</span>
              <span class="sf-title-fragment">
                <span class="sf-title-rule" aria-hidden="true"></span>
                <span class="sf-title-text" data-text="可复用的 Skill">可复用的 Skill</span>
              </span>
            </span>
          </h2>
        </div>
        <div class="sf-hero-ctas sf-rise" style="--delay: .4s">
          <a class="sf-primary-cta" href="/market/" data-portal-route>进入 AI 实战库</a>
        </div>
      </div>

      <div class="sf-hero-marquee sf-rise" style="--delay: .66s" aria-label="电商视觉作品轮播">
        <div class="sf-marquee-curve sf-marquee-curve-top" aria-hidden="true">
          <svg viewBox="0 0 1440 100" preserveAspectRatio="none">
            <path fill="currentColor" d="M0 0H1440V50C1440 50 1200 100 720 100C240 100 0 50 0 50V0Z"></path>
          </svg>
        </div>
        <div class="sf-marquee-curve sf-marquee-curve-bottom" aria-hidden="true">
          <svg viewBox="0 0 1440 100" preserveAspectRatio="none">
            <path fill="currentColor" d="M0 100H1440V50C1440 50 1200 0 720 0C240 0 0 50 0 50V100Z"></path>
          </svg>
        </div>
        <div class="sf-hero-marquee-track" data-sf-hero-marquee-track>
          {heroMarqueeImages.map((src, index) => (
            <button
              class="sf-hero-marquee-card"
              type="button"
              data-sf-image-preview-trigger
              data-sf-preview-src={src}
              aria-label={`预览作品图 ${(index % bespokeMarqueeImages.length) + 1}`}
              aria-hidden={index >= bespokeMarqueeImages.length ? "true" : undefined}
              tabindex={index >= bespokeMarqueeImages.length ? "-1" : undefined}
            >
              <img
                src={src}
                alt=""
                loading={index < bespokeMarqueeImages.length ? "eager" : "lazy"}
                draggable="false"
              />
            </button>
          ))}
        </div>
      </div>

    </section>

    <section class="sf-achievements" id="sf-achievements" aria-labelledby="sfModulesHeading">
      <div class="sf-achievements-header sf-reveal">
        <div class="sf-achievements-title">
          <p class="sf-section-kicker">自主智能</p>
          <h2 id="sfModulesHeading">以系统思维设计</h2>
          <p class="sf-section-copy">
            <span>设计决策，并非一座孤岛</span>
            <span>把生图、生视频、商品内容和私域成交统一成模块</span>
            <span>从第一眼，到每一次点击</span>
          </p>
        </div>
      </div>

      <div class="sf-poster-grid sf-reveal">
        {featuredModuleCards.map((card, index) => (
          <a class="sf-poster-card" href={card.href} data-portal-route aria-label={`查看 ${card.name}`}>
            <div class="sf-poster-meta" aria-hidden="true">
              <span>▧ Image</span>
              <span>720 × 960</span>
            </div>
            <div class="sf-poster-frame">
              <img src={card.image} alt="" loading={index > 1 ? "lazy" : "eager"} />
              <div class="sf-poster-shade"></div>
              <div class="sf-poster-copy">
                <span>{card.job}</span>
                <strong>{card.name}</strong>
                <p>{card.description}</p>
                <em>查看详细内容</em>
              </div>
            </div>
          </a>
        ))}
      </div>
    </section>

    <section class="sf-counter sf-reveal" id="sf-counter" aria-labelledby="sfCounterHeading">
      <div class="sf-system-heading">
        <p class="sf-section-kicker">联系阿臭弟</p>
        <h2 id="sfCounterHeading">如何让 AIGC 赋能我的电商业务</h2>
        <p class="sf-section-copy">
          <span>如果你也在思考这个问题</span>
          <span>可以把产品、类目和当前卡点发我</span>
        </p>
      </div>

      <div class="sf-ai-workbench" aria-label="AIGC 电商业务联系方式">
        <figure class="sf-ai-preview-card">
          <figcaption class="sf-ai-media-label" aria-hidden="true">
            <span>▧ Image</span>
            <span>720 × 960</span>
          </figcaption>
          <div class="sf-ai-preview-frame">
            <img src={systemPreviewImage} alt="" loading="lazy" />
          </div>
        </figure>

        <div class="sf-ai-prompt-card" role="group" aria-label="AIGC 电商业务联系提示">
          <div class="sf-ai-prompt-main">
            <span class="sf-ai-prompt-tag">
              <span class="sf-ai-tag-icon" aria-hidden="true">⌁</span>
              微信联系
            </span>
            <p>YunX0723&nbsp;&nbsp;备注：AIGC电商业务沟通</p>
          </div>
          <div class="sf-ai-prompt-actions">
            <span class="sf-ai-soft-icon" aria-hidden="true">⌘</span>
            <span class="sf-ai-soft-icon" aria-hidden="true">◇</span>
            <button class="sf-ai-send-icon" type="button" data-sf-qr-open aria-label="打开微信二维码">↑</button>
          </div>
        </div>
      </div>
    </section>

  </div>

  <div class="sf-image-preview-overlay" data-sf-image-preview-overlay hidden role="dialog" aria-modal="true" aria-label="图片预览">
    <button class="sf-image-preview-backdrop" type="button" data-sf-image-preview-close aria-label="关闭图片预览"></button>
    <figure class="sf-image-preview-panel">
      <button class="sf-modal-close sf-image-preview-close" type="button" data-sf-image-preview-close aria-label="关闭图片预览">
        <span></span>
        <span></span>
      </button>
      <img data-sf-image-preview-image alt="" />
    </figure>
  </div>

  <div class="sf-qr-overlay" data-sf-qr-overlay hidden role="dialog" aria-modal="true" aria-label="微信二维码">
    <button class="sf-qr-backdrop" type="button" data-sf-qr-close aria-label="关闭微信二维码"></button>
    <div class="sf-qr-panel">
      <button class="sf-modal-close sf-qr-close" type="button" data-sf-qr-close aria-label="关闭微信二维码">
        <span></span>
        <span></span>
      </button>
      <div class="sf-qr-grid" aria-label="微信二维码：有课和作图">
        <figure class="sf-qr-card">
          <img src={wechatQrImage} alt="微信二维码：A.潮汕阿臭弟（有课），微信号 YunX0723，备注 AIGC电商业务沟通" loading="lazy" />
          <figcaption>
            <strong>微信联系：YunX0723</strong>
            <span>备注：AIGC电商业务沟通</span>
          </figcaption>
        </figure>
        <figure class="sf-qr-card">
          <img src={wechatQrDrawingImage} alt="微信二维码：A.潮汕阿臭弟（作图），微信号 YunX0723，备注 AIGC电商业务沟通" loading="lazy" />
          <figcaption>
            <strong>微信联系：YunX0723</strong>
            <span>备注：AIGC电商业务沟通</span>
          </figcaption>
        </figure>
      </div>
    </div>
  </div>
</section>

<script is:inline type="module" src="/scripts/steadyflow-reference.js?v=20260804-qr-dual"></script>

<style>
  @import url("https://fonts.googleapis.com/css2?family=Google+Sans+Flex:wght@500&family=Noto+Serif+SC:wght@400;500&display=swap");

  @font-face {
    font-family: "Stack Sans Headline";
    src: url("https://framerusercontent.com/modules/VqG9xS8K2qN3B8RHWMKb/UQYzREmGJ3JWCi77B0rN/StackSans-Medium.woff2")
      format("woff2");
    font-weight: 500;
    font-style: normal;
    font-display: swap;
  }

  .sf-reference {
    --sf-page-bg: rgb(18, 19, 15);
    --sf-hero-bg: rgb(7, 8, 6);
    --sf-surface: rgb(22, 23, 19);
    --sf-surface-soft: rgb(28, 29, 25);
    --sf-ink: rgb(19, 21, 21);
    --sf-light: rgb(247, 247, 241);
    --sf-blue: #4382bc;
    --sf-logo: #5bb8f0;
    --sf-muted: rgba(247, 247, 241, 0.58);
    --sf-headline: "Stack Sans Headline", sans-serif;
    --sf-serif-display: "Noto Serif SC", "Songti SC", "STSong", "SimSun", ui-serif, Georgia, "Times New Roman", serif;
    --sf-ui: "Google Sans Flex", sans-serif;
    position: relative;
    overflow: hidden;
    background: var(--sf-page-bg);
    color: var(--sf-ink);
    font-family: var(--sf-ui);
    font-weight: 500;
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
  }

  .sf-reference *,
  .sf-reference *::before,
  .sf-reference *::after {
    box-sizing: border-box;
  }

  .sf-reference a {
    color: inherit;
    text-decoration: none;
  }

  .sf-reference button {
    color: inherit;
    font: inherit;
  }

  .sf-frame {
    position: relative;
    overflow: hidden;
    background: var(--sf-page-bg);
  }

  .sf-navbar-wrap {
    position: fixed;
    top: 0;
    right: 0;
    left: 0;
    z-index: 80;
    padding: 30px;
    pointer-events: none;
  }

  .sf-desktop-navbar {
    display: flex;
    width: 100%;
    max-width: 1260px;
    justify-content: space-between;
    gap: 0;
    margin: 0 auto;
    pointer-events: auto;
    transition: gap 0.45s cubic-bezier(0.44, 0, 0.56, 1), justify-content 0.45s cubic-bezier(0.44, 0, 0.56, 1);
  }

  .sf-nav-pill {
    display: flex;
    align-items: center;
    border-radius: 20px;
    background: #fff;
    box-shadow: 0 8px 20px rgba(5, 8, 12, 0.1);
    transition: box-shadow 0.25s ease, transform 0.25s ease;
  }

  .sf-scrolled .sf-nav-pill {
    box-shadow: 0 12px 34px rgba(5, 8, 12, 0.14);
  }

  .sf-brand-pill {
    min-width: 216px;
    gap: 12px;
    padding: 12px 18px 12px 12px;
    color: var(--sf-ink);
  }

  .sf-achoudi-mark {
    position: relative;
    width: 38px;
    height: 38px;
    display: grid;
    place-items: center;
    flex: 0 0 auto;
    border: 1px solid var(--sf-ink);
    border-radius: 50%;
    background: var(--sf-ink);
    color: #fff;
    font-family: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    font-size: 17px;
    font-weight: 900;
    letter-spacing: -0.04em;
  }

  .sf-achoudi-mark::after {
    content: "";
    position: absolute;
    right: -2px;
    bottom: -2px;
    width: 8px;
    height: 8px;
    border: 2px solid #fff;
    border-radius: 50%;
    background: #97c731;
  }

  .sf-compact-mark {
    width: 32px;
    height: 32px;
    font-size: 15px;
  }

  .sf-brand-copy {
    display: flex;
    min-width: 0;
    flex-direction: column;
    gap: 2px;
  }

  .sf-brand-copy strong {
    font-family: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    font-size: 17px;
    font-weight: 850;
    letter-spacing: -0.03em;
    line-height: 1;
  }

  .sf-brand-copy small {
    color: var(--sf-muted);
    font-size: 11px;
    line-height: 1.1;
  }

  .sf-nav-menu {
    height: 64px;
    gap: 32px;
    padding: 0 32px;
    font-size: 14px;
  }

  .sf-nav-menu .nav-link {
    height: 100%;
    display: inline-flex;
    align-items: center;
    padding: 0;
    color: color-mix(in srgb, var(--sf-ink) 72%, transparent);
    font-weight: 700;
    line-height: 1;
    white-space: nowrap;
    transition: color 0.2s ease, opacity 0.2s ease;
  }

  .sf-nav-menu .nav-link::after,
  .sf-mobile-menu-panel .nav-link::after {
    display: none;
  }

  .sf-nav-menu .nav-link:hover,
  .sf-nav-menu .nav-link.active {
    color: var(--sf-ink);
  }

  .sf-action-pill {
    min-width: 216px;
    justify-content: flex-end;
    gap: 12px;
    padding: 6px 6px 6px 16px;
  }

  .sf-service-pulse {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--sf-muted);
    font-family: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    font-size: 12px;
    font-weight: 750;
    white-space: nowrap;
  }

  .sf-service-pulse span {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #b8b8b8;
    box-shadow: 0 0 0 0 rgba(151, 199, 49, 0);
  }

  .sf-service-pulse[data-status="online"] span {
    background: #97c731;
    box-shadow: 0 0 0 6px rgba(151, 199, 49, 0.12);
  }

  .sf-service-pulse[data-status="offline"] span {
    background: #e17a71;
    box-shadow: 0 0 0 6px rgba(225, 122, 113, 0.12);
  }

  .sf-service-pulse b {
    font-weight: 750;
  }

  .sf-icon-button {
    display: grid;
    width: 52px;
    height: 52px;
    place-items: center;
    padding: 0;
    border: 0;
    border-radius: 14px;
    background: var(--sf-ink);
    color: #fff;
    transition: transform 0.45s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .sf-icon-button:hover,
  .sf-primary-cta:hover {
    transform: scale(0.95);
  }

  .sf-icon-button svg {
    width: 21px;
    height: 21px;
    stroke-width: 1.8;
  }

  .sf-mobile-navbar,
  .sf-mobile-menu-backdrop {
    display: none;
  }

  .sf-hero {
    position: relative;
    display: flex;
    --sf-hero-content-top: clamp(122px, 15.6svh, 160px);
    --sf-hero-content-gap: clamp(34px, 5svh, 52px);
    --sf-hero-title-size: clamp(56px, min(4.2vw, 7.8svh), 80px);
    --sf-hero-title-width: min(920px, calc(100vw - 48px));
    --sf-hero-marquee-card-width: clamp(244px, min(17vw, 34svh), 356px);
    --sf-hero-marquee-bottom: clamp(10px, 2svh, 24px);
    --sf-hero-marquee-radius: 0px;
    --sf-hero-curve-height: clamp(26px, 4svh, 40px);
    --sf-hero-marquee-loop-distance: -50%;
    --sf-hero-marquee-duration: 42s;
    width: 100%;
    min-height: 100svh;
    justify-content: center;
    overflow: hidden;
    background: var(--sf-hero-bg);
    scroll-margin-top: var(--portal-floating-nav-clearance, 92px);
  }

  .sf-hero-content {
    position: relative;
    z-index: 1;
    display: flex;
    width: 100%;
    max-width: 980px;
    flex-direction: column;
    align-items: center;
    gap: var(--sf-hero-content-gap);
    padding: var(--sf-hero-content-top) 30px 158px;
    color: #fff;
    text-align: center;
    pointer-events: none;
  }

  .sf-hero-content a,
  .sf-hero-content button {
    pointer-events: auto;
  }

  .sf-copy-stack {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
  }

  .sf-rise {
    opacity: 0;
    transform: translateY(20px);
    animation: sf-rise 0.6s var(--delay, 0s) cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }

  @keyframes sf-rise {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .sf-hero-subtitle {
    margin: 0;
  }

  .sf-kinetic-title {
    display: flex;
    max-width: var(--sf-hero-title-width);
    flex-direction: column;
    align-items: center;
    gap: 2px;
    margin: 0;
    color: rgba(255, 255, 255, 0.98);
    font-family: var(--sf-serif-display);
    font-size: var(--sf-hero-title-size);
    font-weight: 400;
    letter-spacing: -0.035em;
    line-height: 1.02;
    text-shadow: 0 18px 58px rgba(0, 0, 0, 0.18);
  }

  .sf-kinetic-line {
    position: relative;
    display: flex;
    align-items: baseline;
    justify-content: center;
    opacity: 0;
    transform: translateY(18px);
    white-space: nowrap;
    animation: sf-title-line-rise 0.72s var(--line-delay, 0s) cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }

  .sf-title-static {
    position: relative;
    z-index: 2;
  }

  .sf-title-fragment {
    position: relative;
    display: inline-block;
    margin-left: 0.08em;
    padding-inline: 0.01em;
  }

  .sf-title-rule {
    position: absolute;
    right: 0;
    bottom: 0.03em;
    left: 0;
    height: 1px;
    background: rgba(255, 255, 255, 0.66);
    box-shadow: 0 0 18px rgba(255, 255, 255, 0.28);
    transform: scaleX(0);
    transform-origin: left center;
    animation: sf-title-rule-in 1.05s calc(var(--line-delay, 0s) + 0.16s) cubic-bezier(0.65, 0, 0.35, 1) forwards;
  }

  .sf-title-text {
    position: relative;
    z-index: 2;
    display: inline-block;
    color: rgba(255, 255, 255, 0.28);
  }

  .sf-title-text::before,
  .sf-title-text::after {
    content: attr(data-text);
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .sf-title-text::before {
    z-index: 1;
    color: rgba(255, 255, 255, 0.98);
    clip-path: inset(0 100% 0 0);
    animation: sf-title-clip-in 1.16s calc(var(--line-delay, 0s) + 0.08s) cubic-bezier(0.65, 0, 0.35, 1) forwards;
  }

  .sf-title-text::after {
    z-index: 2;
    display: none;
  }

  .sf-hero.sf-replay-pulse .sf-kinetic-line {
    animation: sf-replay-title-line-rise 0.72s var(--line-delay, 0s) cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  .sf-hero.sf-replay-pulse .sf-title-rule {
    animation: sf-replay-title-rule-in 1.05s calc(var(--line-delay, 0s) + 0.16s) cubic-bezier(0.65, 0, 0.35, 1) both;
  }

  .sf-hero.sf-replay-pulse .sf-title-text::before {
    animation: sf-replay-title-clip-in 1.16s calc(var(--line-delay, 0s) + 0.08s) cubic-bezier(0.65, 0, 0.35, 1) both;
  }

  .sf-hero.sf-hero-ready .sf-rise {
    opacity: 1;
    transform: none;
    animation: none;
    filter: none;
  }

  .sf-hero.sf-hero-ready:not(.sf-replay-pulse) .sf-kinetic-line {
    opacity: 1;
    transform: none;
    animation: none;
    filter: none;
  }

  .sf-hero.sf-hero-ready:not(.sf-replay-pulse) .sf-title-rule {
    opacity: 0.72;
    transform: scaleX(1);
    animation: none;
  }

  .sf-hero.sf-hero-ready:not(.sf-replay-pulse) .sf-title-text::before {
    clip-path: inset(0 0 0 0);
    animation: none;
  }

  @keyframes sf-title-line-rise {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes sf-replay-title-line-rise {
    from {
      opacity: 0.18;
      transform: translateY(14px);
      filter: blur(4px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
      filter: none;
    }
  }

  @keyframes sf-title-clip-in {
    0% {
      clip-path: inset(0 100% 0 0);
    }

    55% {
      clip-path: inset(0 24% 0 0);
    }

    100% {
      clip-path: inset(0 0 0 0);
    }
  }

  @keyframes sf-replay-title-clip-in {
    0% {
      clip-path: inset(0 100% 0 0);
    }

    58% {
      clip-path: inset(0 20% 0 0);
    }

    100% {
      clip-path: inset(0 0 0 0);
    }
  }

  @keyframes sf-title-rule-in {
    0% {
      opacity: 0;
      transform: scaleX(0);
    }

    22% {
      opacity: 1;
    }

    100% {
      opacity: 0.72;
      transform: scaleX(1);
    }
  }

  @keyframes sf-replay-title-rule-in {
    0% {
      opacity: 0;
      transform: scaleX(0);
    }

    24% {
      opacity: 1;
    }

    100% {
      opacity: 0.72;
      transform: scaleX(1);
    }
  }

