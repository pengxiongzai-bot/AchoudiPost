    color: rgba(255, 255, 255, 0.4);
    font-size: 11px;
  }

  .sf-phone-actions {
    display: flex;
    gap: 6px;
  }

  .sf-phone-actions button,
  .sf-blue-button {
    display: grid;
    width: 30px;
    height: 30px;
    place-items: center;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.07);
    color: #fff;
  }

  .sf-blue-button {
    border-color: transparent;
    background: var(--sf-blue);
    font-size: 18px;
    line-height: 1;
  }

  .sf-bell {
    width: 12px;
    height: 14px;
    border: 1.8px solid currentColor;
    border-bottom: 0;
    border-radius: 8px 8px 3px 3px;
  }

  .sf-stats-card {
    padding: 13px 13px 10px;
    border: 1px solid rgba(255, 255, 255, 0.04);
    border-radius: 16px;
    background: rgba(0, 0, 0, 0.35);
  }

  .sf-stat-block {
    display: grid;
    flex: 1;
    grid-template-columns: auto auto;
    align-items: center;
    justify-content: center;
    gap: 0 6px;
  }

  .sf-stat-block strong {
    font-family: var(--sf-headline);
    font-size: 22px;
    font-weight: 500;
  }

  .sf-stat-block span:last-child {
    grid-column: 1 / -1;
    margin-top: 1px;
    color: rgba(255, 255, 255, 0.4);
    font-size: 9px;
    text-align: center;
  }

  .sf-stat-block.sf-checks {
    display: flex;
    flex-direction: column;
    gap: 1px;
  }

  .sf-flame {
    color: var(--sf-blue);
    font-size: 12px;
  }

  .sf-stats-divider {
    width: 1px;
    height: 27px;
    background: rgba(255, 255, 255, 0.1);
  }

  .sf-weekday-chart {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 5px;
    margin-top: 11px;
  }

  .sf-weekday {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    color: rgba(255, 255, 255, 0.3);
    font-size: 8px;
  }

  .sf-bar-track {
    display: flex;
    width: 100%;
    height: 30px;
    align-items: flex-end;
    justify-content: center;
    border-radius: 3px;
    background: rgba(255, 255, 255, 0.04);
  }

  .sf-bar {
    display: block;
    width: 8px;
    min-height: 4px;
    border-radius: 4px;
    background: rgba(255, 255, 255, 0.12);
  }

  .sf-bar.sf-active {
    background: rgba(67, 130, 188, 0.62);
  }

  .sf-weekday.sf-today {
    color: #76b6ef;
  }

  .sf-weekday.sf-today .sf-bar {
    background: var(--sf-blue);
    box-shadow: 0 0 10px rgba(67, 130, 188, 0.65);
  }

  .sf-habits-heading {
    padding: 16px 2px 9px;
  }

  .sf-habits-heading h4 {
    margin: 0;
    font-family: var(--sf-headline);
    font-size: 15px;
    font-weight: 500;
  }

  .sf-habits-heading span {
    color: rgba(255, 255, 255, 0.36);
    font-size: 9px;
  }

  .sf-habit-list {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .sf-habit-row {
    display: grid;
    grid-template-columns: 32px 1fr auto 22px;
    align-items: center;
    gap: 8px;
    min-height: 54px;
    padding: 7px 9px;
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 13px;
    background: rgba(255, 255, 255, 0.055);
    opacity: 0;
    transform: translateX(-18px);
    animation: sf-habit-in 0.4s var(--delay) ease forwards;
  }

  @keyframes sf-habit-in {
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  .sf-habit-emoji {
    display: grid;
    width: 32px;
    height: 32px;
    place-items: center;
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.07);
    font-size: 15px;
  }

  .sf-habit-copy {
    display: flex;
    min-width: 0;
    flex-direction: column;
    gap: 3px;
  }

  .sf-habit-copy strong,
  .sf-habit-copy span {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .sf-habit-copy strong {
    font-size: 10px;
    font-weight: 500;
  }

  .sf-habit-copy span {
    color: rgba(255, 255, 255, 0.35);
    font-size: 8px;
  }

  .sf-habit-progress {
    display: grid;
    grid-template-columns: auto auto;
    align-items: center;
    gap: 3px 6px;
  }

  .sf-habit-progress strong,
  .sf-habit-progress > span {
    font-size: 8px;
    font-weight: 500;
  }

  .sf-habit-progress > span {
    color: rgba(255, 255, 255, 0.32);
    text-align: right;
  }

  .sf-mini-progress {
    grid-column: 1 / -1;
    width: 40px;
    height: 3px;
    overflow: hidden;
    border-radius: 3px;
    background: rgba(255, 255, 255, 0.1);
  }

  .sf-mini-progress span {
    display: block;
    width: var(--progress);
    height: 100%;
    border-radius: inherit;
    background: var(--sf-blue);
  }

  .sf-habit-check {
    display: grid;
    width: 20px;
    height: 20px;
    place-items: center;
    border: 1px solid rgba(255, 255, 255, 0.25);
    border-radius: 50%;
    color: #fff;
    font-size: 12px;
  }

  .sf-habit-check.sf-complete {
    border-color: var(--sf-blue);
    background: var(--sf-blue);
  }

  .sf-create-routine {
    display: flex;
    width: 100%;
    align-items: center;
    gap: 9px;
    margin-top: 7px;
    padding: 8px 10px;
    border: 1px dashed rgba(255, 255, 255, 0.18);
    border-radius: 13px;
    background: transparent;
    color: #fff;
    text-align: left;
  }

  .sf-create-plus {
    display: grid;
    width: 30px;
    height: 30px;
    place-items: center;
    border-radius: 9px;
    background: rgba(67, 130, 188, 0.18);
    color: #6bb1ef;
    font-size: 18px;
  }

  .sf-create-routine > span:last-child {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .sf-create-routine strong {
    font-size: 10px;
    font-weight: 500;
  }

  .sf-create-routine small {
    color: rgba(255, 255, 255, 0.33);
    font-size: 8px;
  }

  .sf-phone-bottom-nav {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    margin-top: 9px;
    padding: 8px 2px 2px;
    border-top: 1px solid rgba(255, 255, 255, 0.07);
  }

  .sf-phone-bottom-nav > div {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 3px;
    color: rgba(255, 255, 255, 0.25);
    font-size: 8px;
  }

  .sf-phone-bottom-nav .sf-active {
    color: #63a9e8;
  }

  .sf-hero-curve {
    position: absolute;
    z-index: 2;
    right: -250px;
    bottom: -10px;
    left: -250px;
    width: calc(100% + 500px);
    height: 390px;
    pointer-events: none;
  }

  .sf-video-overlay {
    position: fixed;
    z-index: 100;
    inset: 0;
    display: grid;
    place-items: center;
    padding: 30px;
    background: rgba(19, 21, 21, 0.9);
  }

  .sf-video-overlay[hidden],
  .sf-mobile-menu-backdrop[hidden] {
    display: none;
  }

  .sf-modal-close {
    position: absolute;
    top: 30px;
    right: 30px;
    width: 40px;
    height: 40px;
    border: 0;
    border-radius: 8px;
    background: rgb(247, 247, 247);
    cursor: pointer;
  }

  .sf-modal-close span {
    position: absolute;
    top: 19px;
    left: 10px;
    width: 20px;
    height: 2px;
    border-radius: 2px;
    background: var(--sf-ink);
    transform: rotate(45deg);
  }

  .sf-modal-close span:last-child {
    transform: rotate(-45deg);
  }

  .sf-video-panel {
    width: min(800px, 100%);
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: 20px;
    background: #000;
    box-shadow: 0 40px 100px rgba(0, 0, 0, 0.5);
  }

  .sf-video-panel iframe {
    width: 100%;
    height: 100%;
    border: 0;
  }

  .sf-achievements {
    overflow: hidden;
    padding-top: 200px;
    background: var(--sf-page-bg);
  }

  .sf-achievements-header {
    display: flex;
    max-width: 1260px;
    align-items: flex-end;
    justify-content: space-between;
    gap: 60px;
    margin: 0 auto;
    padding: 0 30px;
  }

  .sf-achievements-title {
    flex: 0.7;
  }

  .sf-achievements h2,
  .sf-counter h2 {
    margin: 0;
    font-family: var(--sf-headline);
    font-size: 48px;
    font-weight: 500;
    letter-spacing: -0.035em;
    line-height: 1.2;
    text-wrap: balance;
  }

  .sf-avatar-strip {
    display: flex;
    width: 320px;
    flex: 0 0 320px;
    align-items: center;
    gap: 18px;
  }

  .sf-avatar-stack {
    display: flex;
    align-items: center;
  }

  .sf-avatar-stack img,
  .sf-module-token,
  .sf-avatar-count {
    width: 40px;
    height: 40px;
    border: 2px solid #fff;
    border-radius: 50%;
  }

  .sf-avatar-stack img {
    margin-left: -8px;
    object-fit: cover;
  }

  .sf-avatar-stack img:first-child,
  .sf-module-token:first-child {
    margin-left: 0;
  }

  .sf-module-token {
    display: grid;
    margin-left: -8px;
    place-items: center;
    background: linear-gradient(145deg, rgba(67, 130, 188, 0.92), rgba(19, 21, 21, 0.92));
    color: #fff;
    font-family: var(--sf-headline);
    font-size: 17px;
  }

  .sf-avatar-count {
    position: relative;
    z-index: 5;
    display: grid;
    margin-left: -8px;
    place-items: center;
    overflow: hidden;
    background: var(--sf-ink);
    color: #fff;
    font-size: 11px;
  }

  .sf-loved-copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 5px;
  }

  .sf-section-kicker,
  .sf-card-kicker,
  .sf-card-link-hint {
    margin: 0;
    font-family: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    font-weight: 850;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .sf-section-kicker {
    margin-bottom: 14px;
    color: var(--sf-blue);
    font-size: 13px;
  }

  .sf-loved-copy img {
    width: auto;
    height: 16px;
  }

  .sf-star-row {
    color: #f2a524;
    font-size: 16px;
    line-height: 1;
    letter-spacing: 1px;
  }

  .sf-loved-copy span {
    color: var(--sf-muted);
    font-size: 18px;
    white-space: nowrap;
  }

  .sf-marquee-container {
    width: 100%;
    margin-top: 50px;
    overflow: hidden;
    cursor: ew-resize;
  }

  .sf-marquee-track {
    display: flex;
    width: max-content;
    gap: 30px;
    padding: 0 15px;
    animation: sf-marquee 60s linear infinite;
  }

  .sf-marquee-container:hover .sf-marquee-track {
    animation-play-state: paused;
  }

  @keyframes sf-marquee {
    0% {
      transform: translateX(0);
    }

    100% {
      transform: translateX(-33.3333%);
    }
  }

  .sf-achievement-card {
    position: relative;
    display: block;
    width: 380px;
    height: 480px;
    flex: 0 0 auto;
    overflow: hidden;
    border-radius: 20px;
    background: var(--sf-ink);
    color: #fff;
  }

  .sf-achievement-card > img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }

  .sf-achievement-card:hover > img {
    transform: scale(1.025);
  }

  .sf-card-gradient {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgb(19, 21, 21) 0%, rgba(255, 255, 255, 0) 50%, rgb(19, 21, 21) 100%);
    opacity: 0.86;
  }

  .sf-card-content {
    position: relative;
    z-index: 1;
    display: flex;
    height: 100%;
    flex-direction: column;
    justify-content: space-between;
    padding: 40px;
  }

  .sf-card-person {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 7px;
    font-size: 15px;
  }

  .sf-card-job {
    color: rgb(184, 184, 184);
  }

  .sf-card-dot {
    color: rgba(255, 255, 255, 0.7);
  }

  .sf-card-result strong {
    display: block;
    margin-bottom: 8px;
    font-family: var(--sf-headline);
    font-size: 50px;
    font-weight: 500;
    letter-spacing: -0.04em;
    line-height: 1;
  }

  .sf-card-kicker {
    display: block;
    margin-bottom: 12px;
    color: rgba(255, 255, 255, 0.62);
    font-size: 11px;
  }

  .sf-card-result p {
    max-width: 285px;
    margin: 0;
    font-family: var(--sf-headline);
    font-size: 24px;
    line-height: 1.22;
    text-wrap: balance;
  }

  .sf-card-link-hint {
    position: absolute;
    right: 34px;
    bottom: 30px;
    color: rgba(255, 255, 255, 0.72);
    font-size: 11px;
  }

  .sf-counter {
    display: flex;
    max-width: 1260px;
    flex-direction: column;
    align-items: center;
    gap: 0;
    margin: 0 auto;
    padding: 200px 30px 180px;
    background: var(--sf-page-bg);
    text-align: center;
  }

  .sf-counter-copy {
    display: flex;
    max-width: 570px;
    flex-direction: column;
    align-items: center;
  }

  .sf-counter-pill {
    margin-bottom: 24px;
    padding: 10px 17px;
    border: 1px solid rgba(19, 21, 21, 0.1);
    border-radius: 999px;
    background: #fff;
    font-size: 14px;
  }

  .sf-counter h2 {
    max-width: 540px;
  }

  .sf-giant-number {
    display: block;
    margin-top: 30px;
    color: var(--sf-blue);
    font-family: var(--sf-headline);
    font-size: 112px;
    font-weight: 500;
    letter-spacing: -0.055em;
    line-height: 1;
  }

  .sf-counter-copy > p {
    margin-top: 8px;
    color: var(--sf-muted);
    font-size: 16px;
  }

  .sf-counter-visual {
    position: relative;
    width: 100%;
    max-width: 1080px;
    margin-top: 42px;
  }

  .sf-earth-stage {
    position: relative;
    width: 100%;
    height: 328px;
  }

  .sf-counter-video-frame {
    position: relative;
    z-index: 2;
    width: 100%;
    height: 328px;
    aspect-ratio: 2.45;
    overflow: hidden;
  }

  .sf-counter-video-frame video {
    position: absolute;
    top: 68%;
    left: 50%;
    width: 100%;
    min-width: 100%;
    height: 620px;
    object-fit: cover;
    object-position: center center;
    mix-blend-mode: darken;
    transform: translate(-50%, -50%);
  }

  .sf-counter-fade {
    position: absolute;
    z-index: 2;
    inset: auto 0 0;
    height: 48%;
    background: linear-gradient(to bottom, rgba(247, 247, 247, 0) 0%, rgba(247, 247, 247, 0.74) 50%, var(--sf-page-bg) 84%);
    pointer-events: none;
  }

  .sf-cloud-overlay {
    position: absolute;
    z-index: 3;
    right: -5%;
    bottom: -48px;
    left: -5%;
    height: 132px;
    background:
      radial-gradient(ellipse at 8% 62%, rgba(255, 255, 255, 0.98) 0 22%, transparent 54%),
      radial-gradient(ellipse at 30% 46%, rgba(255, 255, 255, 0.94) 0 24%, transparent 58%),
      radial-gradient(ellipse at 54% 62%, rgba(255, 255, 255, 0.96) 0 28%, transparent 62%),
      radial-gradient(ellipse at 78% 44%, rgba(255, 255, 255, 0.94) 0 23%, transparent 56%),
      radial-gradient(ellipse at 96% 62%, rgba(255, 255, 255, 0.98) 0 24%, transparent 58%);
    filter: blur(13px);
    opacity: 0.9;
    pointer-events: none;
  }

  .sf-blur-slab {
    position: absolute;
    z-index: 1;
    bottom: -178px;
    left: 50%;
    width: 1600px;
    height: 260px;
    background: var(--sf-page-bg);
    filter: blur(12px);
    transform: translateX(-50%);
  }

  .sf-impact-stats {
    position: relative;
    z-index: 4;
    display: grid;
    width: min(880px, 100%);
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 64px;
    margin: -2px auto 0;
  }

  .sf-impact-stat {
    display: flex;
    min-width: 0;
    flex-direction: column;
    align-items: center;
  }

  .sf-impact-stat strong {
    color: var(--sf-ink);
    font-family: var(--sf-headline);
    font-size: 54px;
    font-weight: 500;
    letter-spacing: -0.045em;
    line-height: 1;
  }

  .sf-impact-stat strong::first-letter,
  .sf-impact-stat strong span {
    color: var(--sf-blue);
  }

  .sf-impact-stat p {
    max-width: 190px;
    margin-top: 10px;
    color: var(--sf-muted);
    font-size: 14px;
    line-height: 1.28;
    text-wrap: balance;
  }

  .sf-reveal {
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94), transform 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .sf-reveal.sf-in-view {
    opacity: 1;
    transform: translateY(0);
  }

  @media (max-width: 1023px) {
    .sf-navbar-wrap {
      padding: 20px 30px;
    }

    .sf-desktop-navbar {
      display: none;
    }

    .sf-mobile-navbar {
      display: flex;
      width: 100%;
      max-width: 760px;
      align-items: center;
      justify-content: space-between;
      margin: 0 auto;
      padding: 10px;
      border-radius: 16px;
      background: #fff;
      box-shadow: 0 8px 20px rgba(5, 8, 12, 0.1);
      pointer-events: auto;
    }

    .sf-mobile-brand,
    .sf-mobile-actions {
      display: flex;
      align-items: center;
    }

    .sf-mobile-brand {
      gap: 9px;
      min-width: 0;
      color: var(--sf-ink);
    }

    .sf-mobile-actions {
      gap: 5px;
    }

    .sf-mobile-status {
      height: 44px;
      padding: 0 12px;
      border: 1px solid rgba(19, 21, 21, 0.08);
      border-radius: 12px;
      background: rgba(19, 21, 21, 0.03);
    }

    .sf-hamburger {
      position: relative;
      width: 40px;
      height: 40px;
      margin-left: 1px;
      border: 0;
      border-radius: 10px;
      background: var(--sf-ink);
    }

    .sf-hamburger span {
      position: absolute;
      top: 16px;
      left: 10px;
      width: 20px;
      height: 2px;
      border-radius: 2px;
      background: #fff;
      transition: transform 0.3s ease, top 0.3s ease;
    }

    .sf-hamburger span:last-child {
      top: 23px;
    }

    .sf-menu-open .sf-hamburger span {
      top: 19px;
      transform: rotate(45deg);
    }

    .sf-menu-open .sf-hamburger span:last-child {
      transform: rotate(-45deg);
    }

    .sf-mobile-menu-backdrop {
      position: fixed;
      z-index: 70;
      inset: 0;
      display: block;
      padding: 0 30px;
      background: rgba(0, 0, 0, 0.4);
      backdrop-filter: blur(12px);
    }

    .sf-mobile-menu-panel {
      position: relative;
      top: 100px;
      display: flex;
      width: 100%;
      max-width: 760px;
      flex-direction: column;
      gap: 4px;
      margin: 0 auto;
      padding: 24px;
      border-radius: 16px;
      background: #fff;
      box-shadow: 0 24px 70px rgba(5, 8, 12, 0.22);
    }

    .sf-mobile-menu-panel a {
      padding: 13px 4px;
      border-bottom: 1px solid rgba(19, 21, 21, 0.08);
      color: var(--sf-muted);
      font-size: 16px;
      font-weight: 750;
    }

    .sf-mobile-menu-panel a:hover,
    .sf-mobile-menu-panel a.active {
      color: var(--sf-ink);
    }

    .sf-mobile-menu-panel a:last-child {
      border-bottom: 0;
    }

    .sf-hero h2 {
      font-size: 60px;
    }

    .sf-hero-subtitle {
      font-size: 20px;
    }

    .sf-hero-curve {
      right: -180px;
      left: -180px;
      width: calc(100% + 360px);
    }

    .sf-achievements h2,
    .sf-counter h2 {
