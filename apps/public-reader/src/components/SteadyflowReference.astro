    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 20px;
    overflow: hidden;
    border: 1px solid rgba(247, 247, 241, 0.08);
    border-radius: 8px;
    padding: clamp(44px, 6vw, 72px) clamp(28px, 6vw, 74px);
    background:
      linear-gradient(180deg, rgba(247, 247, 241, 0.035), rgba(247, 247, 241, 0.012)),
      #151712;
    box-shadow:
      inset 0 1px 0 rgba(247, 247, 241, 0.05),
      0 28px 92px rgba(0, 0, 0, 0.34);
